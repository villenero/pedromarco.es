---
import Base from '../../layouts/Base.astro';
import fs from 'node:fs';
import path from 'node:path';

// Load obras grouped by year
const obrasRaw = JSON.parse(fs.readFileSync(path.resolve('obras.json'), 'utf-8'));
const obrasByYear: Record<string, Array<{id: string, titulo: string, imagen: string}>> = {};
for (const o of obrasRaw.obras) {
  if (o.año && o.imagen) {
    const y = String(o.año);
    if (!obrasByYear[y]) obrasByYear[y] = [];
    obrasByYear[y].push({ id: o.id, titulo: o.titulo, imagen: o.imagen });
  }
}

// Biographical milestones
const milestones: Record<string, string> = {
  '1949': 'Nace en Villena',
  '1966': 'Primera exposición (Caja de Ahorros del Sureste)',
  '1972': 'Se dedica por completo a las artes plásticas',
  '1979': 'Estancia formativa en París',
  '1980': 'Estancia formativa en Bruselas',
  '1982': 'Beca de grabado en Hamburgo, Alemania',
  '1986': 'Seleccionado Premio Internacional Joan Miró, Barcelona',
  '1990': "Ken's Art Gallery, Florencia",
  '1994': 'Galería Studio D, Londres',
  '1999': "Galerie L'Entrée des Artistes, Barbizon, Francia",
  '2006': 'Retrospectiva 1966-2006, KAKV Villena',
  '2022': 'Fallece en Villena (4 de febrero)',
  '2024': 'Exposición póstuma — Tras los Pasos de Ilici, MACE Elche',
};

// Collect all years (from milestones + obras), sorted chronologically
const allYearsSet = new Set<string>();
Object.keys(milestones).forEach(y => allYearsSet.add(y));
Object.keys(obrasByYear).forEach(y => allYearsSet.add(y));
const allYears = [...allYearsSet].map(Number).sort((a, b) => a - b);

// Build stops data for the template
interface Stop {
  year: number;
  milestone: string | null;
  obras: Array<{id: string, titulo: string, imagen: string}>;
  side: 'left' | 'right';
}

const stops: Stop[] = allYears.map((y, i) => ({
  year: y,
  milestone: milestones[String(y)] || null,
  obras: obrasByYear[String(y)] || [],
  side: i % 2 === 0 ? 'left' : 'right',
}));

// Serialize for JS
const stopsJson = JSON.stringify(stops.map(s => ({ year: s.year, milestone: s.milestone !== null })));
---

<Base
  title="Pedro Marco — Recorrido artístico"
  description="Recorrido por la trayectoria artística de Pedro Marco (Villena, 1949-2022). Biografia, hitos y obras organizadas cronologicamente."
>
  <div class="bg-amber-50/30 min-h-screen">
    <!-- Header -->
    <div class="text-center pt-12 pb-12 px-4 max-w-2xl mx-auto">
      <p class="text-sm font-semibold uppercase tracking-widest text-amber-800/60 mb-2">Trayectoria artística</p>
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-6">Recorrido</h1>
      <p class="text-gray-600 leading-relaxed">
        Desde su primera exposición con apenas diecisiete años hasta la muestra póstuma en el MACE de Elche, 
        Pedro Marco dejó su huella —como el caracol que firmaba sus obras— a lo largo de casi seis décadas 
        de creación. Este recorrido traza el camino de una vida entregada al arte: los viajes que alimentaron 
        su imaginario, las exposiciones que llevaron su surrealismo de Villena al mundo, y las obras que 
        fueron naciendo en cada etapa del camino.
      </p>
    </div>

    <!-- Timeline container -->
    <div id="timeline-container" class="relative max-w-5xl mx-auto px-4 pb-24">
      <!-- SVG path layer -->
      <svg id="timeline-svg" class="absolute inset-0 w-full h-full pointer-events-none" preserveAspectRatio="none">
        <defs>
          <filter id="brush-stroke" x="-5%" y="-5%" width="110%" height="110%">
            <feTurbulence type="turbulence" baseFrequency="0.04" numOctaves="4" result="turbulence" seed="3" />
            <feDisplacementMap in="SourceGraphic" in2="turbulence" scale="3" xChannelSelector="R" yChannelSelector="G" />
          </filter>
        </defs>
        <!-- Background path (thick, rough) -->
        <path id="timeline-path-bg" fill="none" stroke="#d4a574" stroke-width="6" stroke-linecap="round" opacity="0.25" filter="url(#brush-stroke)" />
        <!-- Progress path (fills as you scroll) -->
        <path id="timeline-path-progress" fill="none" stroke="#92400e" stroke-width="3" stroke-linecap="round" filter="url(#brush-stroke)" />
        <!-- Full path for measurement (invisible) -->
        <path id="timeline-path" fill="none" stroke="transparent" stroke-width="1" />
      </svg>

      <!-- Snail -->
      <img
        id="snail"
        src="/favicon.png"
        alt=""
        class="absolute w-10 h-10 sm:w-12 sm:h-12 pointer-events-none z-20 opacity-0 transition-opacity duration-500"
        style="transform-origin: center center;"
      />

      <!-- Year stops -->
      {stops.map((stop, i) => (
        <div
          class={`timeline-stop mb-16 sm:mb-24 opacity-0 translate-y-8`}
          data-year={stop.year}
          data-side={stop.side}
          data-index={i}
        >
          <!-- Content -->
          <div>
            <!-- Year label -->
            <div class="mb-3">
              <span class={`text-2xl sm:text-3xl font-black ${stop.milestone ? 'text-amber-800' : 'text-gray-700'}`}>
                {stop.year}
              </span>
            </div>

            {/* Milestone text */}
            {stop.milestone && (
              <p class="text-sm sm:text-base text-amber-800/80 font-medium mb-3 italic">
                {stop.milestone}
              </p>
            )}

            {/* Artwork thumbnails */}
            {stop.obras.length > 0 && (
              <div class={`grid grid-cols-3 sm:grid-cols-4 gap-1.5 sm:gap-2 mt-2 max-w-[20rem] ${stop.side === 'left' ? 'ml-auto' : ''}`} style={stop.side === 'left' ? 'direction:rtl' : ''}>
                {stop.obras.slice(0, 8).map((obra) => (
                  <a
                    href={`/es/obra/${obra.id}`}
                    title={obra.titulo}
                    class="block aspect-square rounded-md overflow-hidden border border-amber-200/50 hover:border-amber-500 hover:scale-105 transition-all duration-200 shadow-sm hover:shadow-md"
                    style="direction:ltr"
                  >
                    <img
                      src={`/obras/thumbs/${obra.imagen}`}
                      alt={obra.titulo}
                      class="w-full h-full object-cover"
                      loading="lazy"
                    />
                  </a>
                ))}
                {stop.obras.length > 8 && (
                  <div class="aspect-square rounded-md bg-amber-100/60 border border-amber-200/50 flex items-center justify-center text-sm text-amber-700 font-medium">
                    +{stop.obras.length - 8}
                  </div>
                )}
              </div>
            )}
          </div>
        </div>
      ))}

      <!-- End marker -->
      <div class="text-center py-8">
        <img src="/favicon.png" alt="" class="w-8 h-8 mx-auto opacity-30 mb-2" />
        <p class="text-sm text-gray-400 italic">El arte permanece</p>
      </div>
    </div>
  </div>

  <script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    var container = document.getElementById('timeline-container');
    var svg = document.getElementById('timeline-svg');
    var pathEl = document.getElementById('timeline-path');
    var pathBg = document.getElementById('timeline-path-bg');
    var pathProgress = document.getElementById('timeline-path-progress');
    var snail = document.getElementById('snail');
    var stops = document.querySelectorAll('.timeline-stop');

    if (!container || !svg || !pathEl || !snail || stops.length === 0) return;

    var isMobile = window.innerWidth < 640;

    // Seeded pseudo-random (mulberry32) — deterministic across loads
    function mulberry32(seed) {
      return function() {
        seed |= 0; seed = seed + 0x6D2B79F5 | 0;
        var t = Math.imul(seed ^ seed >>> 15, 1 | seed);
        t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;
        return ((t ^ t >>> 14) >>> 0) / 4294967296;
      };
    }
    var rand = mulberry32(42);

    // Compute path control points from stop positions
    function buildPath() {
      isMobile = window.innerWidth < 640;
      // Reset seed for deterministic path on every rebuild
      rand = mulberry32(42);

      var containerRect = container.getBoundingClientRect();
      var containerW = containerRect.width;
      var centerX = isMobile ? containerW * 0.15 : containerW * 0.5;
      var baseAmplitude = isMobile ? containerW * 0.06 : containerW * 0.06;

      // Gather Y positions for each stop
      var points = [];
      var firstStop = stops[0];
      var firstY = firstStop.offsetTop - 40;
      points.push({ x: centerX, y: firstY });

      stops.forEach(function(stop, i) {
        var y = stop.offsetTop + 20;
        var side = stop.getAttribute('data-side');
        var offsetX = 0;
        // Vary amplitude randomly per stop
        var ampScale = 0.5 + rand() * 1.5; // 0.5x to 2x base amplitude
        var amp = baseAmplitude * ampScale;
        // Occasionally flip the expected side for asymmetry
        var flip = rand() > 0.75 ? -1 : 1;
        offsetX = (side === 'right' ? -amp : amp) * flip;
        // Add small random lateral jitter
        offsetX += (rand() - 0.5) * baseAmplitude * 0.4;
        points.push({ x: centerX + offsetX, y: y });
      });

      // End point below last stop
      var lastStop = stops[stops.length - 1];
      var lastY = lastStop.offsetTop + lastStop.offsetHeight + 40;
      points.push({ x: centerX, y: lastY });

      // Reset seed again for deterministic S-curve insertion
      var rand2 = mulberry32(137);

      // Build smooth cubic bezier path with varied control points
      var d = 'M ' + points[0].x + ' ' + points[0].y;
      for (var i = 1; i < points.length; i++) {
        var prev = points[i - 1];
        var curr = points[i];
        var segH = curr.y - prev.y;
        // Vary control point distance asymmetrically
        var cpFrac1 = 0.25 + rand2() * 0.3; // 0.25–0.55
        var cpFrac2 = 0.25 + rand2() * 0.3;
        // Add lateral offset to control points for S-curves
        var cpLateral = (rand2() - 0.5) * baseAmplitude * 1.2;
        var cp1x = prev.x + cpLateral * 0.5;
        var cp1y = prev.y + segH * cpFrac1;
        var cp2x = curr.x - cpLateral * 0.5;
        var cp2y = curr.y - segH * cpFrac2;
        d += ' C ' + cp1x + ' ' + cp1y + ', ' + cp2x + ' ' + cp2y + ', ' + curr.x + ' ' + curr.y;
      }

      pathEl.setAttribute('d', d);
      pathBg.setAttribute('d', d);
      pathProgress.setAttribute('d', d);

      // Set SVG dimensions
      svg.setAttribute('width', containerW);
      svg.setAttribute('height', container.scrollHeight);
      svg.style.width = containerW + 'px';
      svg.style.height = container.scrollHeight + 'px';

      // Set dash for progress
      var totalLen = pathEl.getTotalLength();
      pathProgress.style.strokeDasharray = totalLen;
      pathProgress.style.strokeDashoffset = totalLen;

      return totalLen;
    }

    var totalLength = buildPath();

    // Build a lookup table: Y position → path length (for accurate Y-based positioning)
    // This solves the problem where horizontal curves add path length that doesn't correspond to vertical progress
    var yToLenSamples = 500;
    var yToLenTable = []; // [{y, len}]
    function buildYToLenTable() {
      yToLenTable = [];
      for (var s = 0; s <= yToLenSamples; s++) {
        var l = (s / yToLenSamples) * totalLength;
        var pt = pathEl.getPointAtLength(l);
        yToLenTable.push({ y: pt.y, len: l });
      }
    }
    buildYToLenTable();

    // Binary search: given a target Y, find the path length where the path reaches that Y
    function yToLength(targetY) {
      // Clamp to path extents
      var firstY = yToLenTable[0].y;
      var lastY = yToLenTable[yToLenTable.length - 1].y;
      if (targetY <= firstY) return 0;
      if (targetY >= lastY) return totalLength;

      // Binary search for the closest sample
      var lo = 0, hi = yToLenTable.length - 1;
      while (lo < hi - 1) {
        var mid = (lo + hi) >> 1;
        if (yToLenTable[mid].y < targetY) lo = mid;
        else hi = mid;
      }
      // Interpolate between lo and hi
      var a = yToLenTable[lo], b = yToLenTable[hi];
      var frac = (b.y - a.y) > 0 ? (targetY - a.y) / (b.y - a.y) : 0;
      return a.len + frac * (b.len - a.len);
    }

    // Get path X coordinate at a given Y
    function getPathXAtY(targetY) {
      var len = yToLength(targetY);
      var pt = pathEl.getPointAtLength(len);
      return pt.x;
    }

    // Position each stop horizontally relative to the path's X at that stop's Y
    var GAP_FROM_PATH = 40; // px gap between path and content
    function positionStops() {
      var containerW = container.getBoundingClientRect().width;
      stops.forEach(function(stop) {
        var side = stop.getAttribute('data-side');
        var stopY = stop.offsetTop + 20;
        var pathX = getPathXAtY(stopY);

        if (isMobile) {
          stop.style.marginLeft = (pathX + GAP_FROM_PATH) + 'px';
          stop.style.width = (containerW - pathX - GAP_FROM_PATH) + 'px';
          stop.style.textAlign = 'left';
        } else if (side === 'right') {
          // Content to the right of the path, left-aligned (grows away from path)
          stop.style.marginLeft = (pathX + GAP_FROM_PATH) + 'px';
          stop.style.width = (containerW - pathX - GAP_FROM_PATH) + 'px';
          stop.style.textAlign = 'left';
        } else {
          // Content to the left of the path, right-aligned (grows away from path)
          stop.style.marginLeft = '0';
          stop.style.width = (pathX - GAP_FROM_PATH) + 'px';
          stop.style.textAlign = 'right';
        }
      });
    }
    positionStops();

    // Precompute stop Y positions (center of each stop element, relative to container)
    var stopYPositions = [];
    function computeStopPositions() {
      stopYPositions = [];
      stops.forEach(function(stop) {
        stopYPositions.push(stop.offsetTop + stop.offsetHeight * 0.5);
      });
    }
    computeStopPositions();

    // Track which stops have been "entered" (for one-time translateY animation)
    var stopsRevealed = new Array(stops.length);
    for (var si = 0; si < stops.length; si++) stopsRevealed[si] = false;

    // Show snail
    snail.style.opacity = '1';

    // Get the Y coordinates of path start and end
    var pathStartY = yToLenTable[0].y;
    var pathEndY = yToLenTable[yToLenTable.length - 1].y;

    // Scroll handler: move snail along path, fade stops by proximity
    function onScroll() {
      var scrollTop = window.scrollY || window.pageYOffset;
      var vh = window.innerHeight;

      // Simple linear mapping: scroll=0 → snail at path start, scroll=max → snail at path end
      // This guarantees the snail starts at the first point and reaches the last point
      var scrollMax = document.documentElement.scrollHeight - vh;
      var scrollFrac = scrollMax > 0 ? scrollTop / scrollMax : 0;
      scrollFrac = Math.max(0, Math.min(1, scrollFrac));

      // Map scroll fraction to a Y coordinate on the path, then use Y→length lookup
      var targetY = pathStartY + scrollFrac * (pathEndY - pathStartY);
      var len = yToLength(targetY);

      // Update progress path
      pathProgress.style.strokeDashoffset = totalLength - len;

      // Position snail
      var snailY = 0;
      try {
        var point = pathEl.getPointAtLength(len);
        var point2 = pathEl.getPointAtLength(Math.min(len + 2, totalLength));
        var angle = Math.atan2(point2.y - point.y, point2.x - point.x) * (180 / Math.PI);

        var snailSize = isMobile ? 20 : 24;
        snail.style.left = (point.x - snailSize) + 'px';
        snail.style.top = (point.y - snailSize) + 'px';
        snail.style.transform = 'rotate(' + (angle - 90) + 'deg)';
        snailY = point.y;
      } catch(e) {}

      // Fix 3: Fade stops based on proximity to snail
      stops.forEach(function(stop, i) {
        var stopCenterY = stopYPositions[i];
        var dist = Math.abs(stopCenterY - snailY);
        var opacity = Math.max(0.15, 1 - dist / 600);

        // One-time reveal animation (translateY entrance with temporary transition)
        if (!stopsRevealed[i] && opacity > 0.3) {
          stopsRevealed[i] = true;
          stop.style.transition = 'transform 0.6s ease-out';
          stop.style.transform = 'translateY(0)';
          // Remove transition after animation completes so it doesn't slow down opacity updates
          setTimeout(function() { stop.style.transition = ''; }, 650);
        }

        stop.style.opacity = opacity;
      });
    }

    // Throttled scroll
    var ticking = false;
    window.addEventListener('scroll', function() {
      if (!ticking) {
        requestAnimationFrame(function() {
          onScroll();
          ticking = false;
        });
        ticking = true;
      }
    });

    // Rebuild on resize
    var resizeTimer;
    window.addEventListener('resize', function() {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function() {
        totalLength = buildPath();
        buildYToLenTable();
        pathStartY = yToLenTable[0].y;
        pathEndY = yToLenTable[yToLenTable.length - 1].y;
        positionStops();
        computeStopPositions();
        onScroll();
      }, 200);
    });

    // Initial position
    onScroll();
  });
  </script>
</Base>
