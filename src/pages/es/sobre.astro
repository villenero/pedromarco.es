---
import Base from '../../layouts/Base.astro';
import { t } from '../../i18n/utils';
import fs from 'node:fs';
import path from 'node:path';

// Cargar obras para mostrar miniaturas por año
const obrasRaw = JSON.parse(fs.readFileSync(path.resolve('obras.json'), 'utf-8'));
const obrasByYear: Record<string, Array<{id: string, titulo: string, imagen: string}>> = {};
for (const o of obrasRaw.obras) {
  if (o.año && o.imagen) {
    const y = String(o.año);
    if (!obrasByYear[y]) obrasByYear[y] = [];
    obrasByYear[y].push({ id: o.id, titulo: o.titulo, imagen: o.imagen });
  }
}

// Agrupar obras de años anteriores al primer año del timeline (1966)
// con el año más antiguo que sí tenga eventos
const earliestTimelineYear = 1966;
const yearsToMerge = Object.keys(obrasByYear)
  .map(Number)
  .filter(y => y < earliestTimelineYear)
  .sort((a, b) => a - b);
if (yearsToMerge.length > 0) {
  const targetYear = String(earliestTimelineYear);
  if (!obrasByYear[targetYear]) obrasByYear[targetYear] = [];
  for (const y of yearsToMerge) {
    obrasByYear[targetYear].push(...obrasByYear[String(y)]);
    delete obrasByYear[String(y)];
  }
}

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Pedro Marco",
  "birthDate": "1949",
  "deathDate": "2022",
  "birthPlace": { "@type": "Place", "name": "Villena, Alicante, España" },
  "nationality": "Española",
  "jobTitle": "Pintor",
  "description": "Pedro Marco (Villena, Alicante, 1949-2022) se dedicó por completo a las artes plásticas desde 1972. Autodidacta de formación, se especializó en grabado tras una beca en Hamburgo (Alemania) en 1982.",
  "knowsAbout": ["Pintura", "Grabado", "Surrealismo", "Artes plásticas"],
  "sameAs": "https://pedromarco.es"
};

// Fusionar todos los eventos en un solo timeline
const allEvents = [
  // Exposiciones Individuales
  { year: 2024, type: 'expo', title: 'Pedro Marco. Tras los Pasos de Ilici', venue: 'Museo de Arte Contemporáneo de Elche (Alicante)' },
  { year: 2021, type: 'expo', title: 'Pedro Marco. Arte Celular', venue: 'Bar - Galería Experimental El Túnel, Villena (Alicante)' },
  { year: 2016, type: 'expo', title: 'Pedro Marco a Lorca. Dibujos', venue: 'Bar - Galería Experimental El Túnel, Villena (Alicante)' },
  { year: 2013, type: 'expo', title: 'Pedro Marco. Nuestros Tesoros', venue: 'Bar - Galería Experimental El Túnel, Villena (Alicante)' },
  { year: 2011, type: 'expo', title: 'Eros', venue: 'Bar - Galería Experimental El Túnel, Villena (Alicante)' },
  { year: 2010, type: 'expo', title: 'Pedro Marco. Onirismos', venue: 'Fundación Eberhard Schlotter, Altea (Alicante)' },
  { year: 2006, type: 'expo', title: 'Pedro Marco 1966-2006', venue: 'Kakv, Villena (Alicante)' },
  { year: 2005, type: 'expo', title: 'Pedro Marco', venue: 'Bar - Galería Experimental El Túnel, Villena (Alicante)' },
  { year: 2004, type: 'expo', title: 'Pedro Marco', venue: 'Sala de Exposiciones de la Casa Municipal de Cultura, Yecla (Murcia)' },
  { year: 2001, type: 'expo', title: 'Latitudes', venue: 'Sala de Exposiciones Juana Francés, Alicante' },
  { year: 1999, type: 'expo', title: 'Pedro Marco', venue: "Galerie L'Entree des Artistes, Barbizon, Francia" },
  { year: 1998, type: 'expo', title: 'Pedro Marco', venue: 'Casa del Gobernador, Tabarca (Alicante)' },
  { year: 1997, type: 'expo', title: 'Pedro Marco', venue: 'Sala de Exposiciones Casa de Cultura, Biar (Alicante)' },
  { year: 1996, type: 'expo', title: 'Constelaciones', venue: 'Bar - Galería Experimental El Túnel, Villena (Alicante)' },
  { year: 1995, type: 'expo', title: 'Efluvios. Pedro Marco', venue: 'Palacio Gravina, Alicante' },
  { year: 1994, type: 'expo', title: 'Pedro Marco', venue: 'Galería de Arte Studio D, Londres' },
  { year: 1993, type: 'expo', title: 'Pedro Marco', venue: 'Galería Tábula, Moraira (Alicante)' },
  { year: 1992, type: 'expo', title: 'Pedro Marco', venue: 'Kakv, Villena (Alicante)' },
  { year: 1991, type: 'expo', title: 'Pedro Marco. 24 horas dibujando', venue: 'Bar - Galería Experimental El Túnel, Villena (Alicante)' },
  { year: 1990, type: 'expo', title: 'Pedro Marco', venue: "Ken's Art Gallery, Florencia" },
  { year: 1985, type: 'expo', title: 'Obras de Pedro Marco', venue: 'Trama Art, Barcelona' },
  { year: 1983, type: 'expo', title: 'Pedro Marco. Culto a la Naturaleza', venue: 'Bar - Galería Experimental El Túnel, Villena (Alicante)' },
  { year: 1982, type: 'expo', title: 'Villena en pinzas', venue: 'Sala de Exposiciones del Círculo Agrícola Mercantil Villenense, Villena (Alicante)' },
  { year: 1981, type: 'expo', title: 'Pedro Marco', venue: 'Sala Goya, Casa de España, París' },
  { year: 1979, type: 'expo', title: 'Pedro Marco', venue: 'Galería Amics, Alicante' },
  { year: 1977, type: 'expo', title: 'Pedro Marco', venue: 'Sala de Exposiciones, Caja de Ahorros de Alicante y Murcia, Villena (Alicante)' },
  { year: 1976, type: 'expo', title: 'Pedro Marco. Dibujos', venue: 'Galería Chys, Murcia' },
  { year: 1975, type: 'expo', title: 'Pedro Marco', venue: 'Sala de Exposiciones del Ministerio de Información y Turismo, San Sebastián' },
  { year: 1975, type: 'expo', title: 'Pedro Marco. Óleos y dibujos', venue: 'A Delta, Sala de Arte, Madrid' },
  { year: 1974, type: 'expo', title: 'Pedro Marco', venue: 'Sala de Exposiciones del Ministerio de Información y Turismo, San Sebastián' },
  { year: 1972, type: 'expo', title: 'Pedro Marco', venue: 'Sala de Exposiciones del Círculo Agrícola Mercantil Villenense, Villena (Alicante)' },
  { year: 1972, type: 'expo', title: 'Pedro Marco. Dibujos', venue: 'Hall Teatro Chapí, Villena (Alicante)' },
  { year: 1966, type: 'expo', title: 'Exposición de Pintura de Pedro Marco', venue: 'Aula de Cultura de la Caja de Ahorros del Sureste de España, Villena (Alicante)' },
  
  // Certámenes, Salones y Bienales
  { year: 2002, type: 'certamen', title: 'IV Bienal de Artistas Plásticos Solidarios', venue: 'Mapayn Mundi' },
  { year: 2000, type: 'certamen', title: 'II Bienal de Artistas Plásticos Solidarios', venue: 'Mapayn Mundi' },
  { year: 1994, type: 'certamen', title: 'Convocatoria Al voltant del dibuix', venue: 'Jávea (Alicante)' },
  { year: 1991, type: 'certamen', title: 'III Convocatoria de Artes Plásticas', venue: 'Ciudad de Villena (Alicante)' },
  { year: 1989, type: 'certamen', title: 'X Concurso Nacional de Pintura de Minicuadros', venue: 'Elda (Alicante)' },
  { year: 1989, type: 'certamen', title: 'X Convocatoria de Artes Plásticas', venue: 'Diputación de Alicante', note: 'Presentado' },
  { year: 1989, type: 'certamen', title: 'XII Certamen Nacional de Pintura Eusebio Sempere', venue: 'Onil (Alicante)', note: 'Primer Premio Provincial' },
  { year: 1988, type: 'certamen', title: 'IX Convocatoria de Artes Plásticas', venue: 'Diputación de Alicante', note: 'Presentado' },
  { year: 1988, type: 'certamen', title: '65 Salon Société des Artistes Méridionaux', venue: 'Palais des Arts, Toulouse, Francia', note: 'Seleccionado' },
  { year: 1987, type: 'certamen', title: 'III Certamen de Pintura', venue: 'Villa de Sax (Alicante)', note: 'Finalista' },
  { year: 1986, type: 'certamen', title: 'VII Convocatoria de Artes Plásticas', venue: 'Diputación de Alicante', note: 'Presentado' },
  { year: 1986, type: 'certamen', title: "II Bienal d'Art sobre el Deporte", venue: 'Barcelona', note: 'Seleccionado' },
  { year: 1986, type: 'certamen', title: 'XXV Convocatoria del Premio Internacional de Dibujo Joan Miró', venue: 'Fundació Joan Miró, Barcelona', note: 'Seleccionado' },
  { year: 1985, type: 'certamen', title: "I Bienal d'Art sobre el Deporte", venue: 'Barcelona', note: 'Seleccionado' },
  { year: 1985, type: 'certamen', title: 'XXIV Convocatoria del Premio Internacional de Dibujo Joan Miró', venue: 'Fundació Joan Miró, Barcelona', note: 'Seleccionado' },
  { year: 1985, type: 'certamen', title: 'I Bienal de Pintura de Chinchilla', venue: 'Albacete' },
  { year: 1985, type: 'certamen', title: 'VI Convocatoria de Artes Plásticas', venue: 'Diputación de Alicante', note: 'Adquirida' },
  { year: 1983, type: 'certamen', title: 'I Bienal de Pintura Emilio Varela', venue: 'Alicante', note: 'Finalista' },
  { year: 1981, type: 'certamen', title: 'XI Reunión Provincial de Artes Plásticas', venue: '', note: 'Presentado' },
  { year: 1979, type: 'certamen', title: 'Premio Ciudad de Alicante', venue: '', note: 'Seleccionado' },
  { year: 1979, type: 'certamen', title: 'X Reunión de Artes Plásticas', venue: 'Instituto de Estudios Alicantinos, Alicante', note: 'Adquirida' },
  { year: 1978, type: 'certamen', title: 'Premio Eusebio Sempere', venue: 'Onil (Alicante)', note: 'Seleccionado' },
  { year: 1977, type: 'certamen', title: 'II Convocatoria de Artes Plásticas', venue: 'Diputación de Alicante', note: 'Presentado' },
  { year: 1976, type: 'certamen', title: 'III Exposición Nacional de Arte', venue: 'Villena (Alicante)' },
  { year: 1976, type: 'certamen', title: 'VIII Certamen Provincial de Artes Plásticas', venue: 'Instituto de Estudios Alicantinos, Alicante', note: 'Adquiridas' },
  { year: 1975, type: 'certamen', title: 'IV Salón de Pintura de Sagunto', venue: 'Valencia' },
  { year: 1975, type: 'certamen', title: 'II Exposición Nacional de Arte', venue: 'Villena (Alicante)' },
  { year: 1975, type: 'certamen', title: 'I Convocatoria de Artes Plásticas', venue: 'Diputación de Alicante', note: 'Presentado' },
  { year: 1974, type: 'certamen', title: 'XLIV Salón de Otoño', venue: 'Madrid' },
  { year: 1974, type: 'certamen', title: 'VI Certamen Provincial de Artes Plásticas', venue: 'Instituto de Estudios Alicantinos, Alicante', note: 'Adquiridas' },
  { year: 1973, type: 'certamen', title: 'I Salón de Arte Centro Plaza Caracas', venue: '', note: 'Adquiridas' },

  // Estancias Formativas y Creativas
  { year: 2004, type: 'estancia', title: 'Estancia formativa', venue: 'Tindurf, Argelia' },
  { year: 1997, type: 'estancia', title: 'Estancia formativa', venue: 'Jordania y Siria' },
  { year: 1994, type: 'estancia', title: 'Estancia formativa', venue: 'Londres, Reino Unido' },
  { year: 1991, type: 'estancia', title: 'Estancia formativa', venue: 'País Vasco, España' },
  { year: 1990, type: 'estancia', title: 'Estancia formativa', venue: 'Vigonovo, Italia' },
  { year: 1983, type: 'estancia', title: 'Estancia formativa', venue: 'Hamburgo, Alemania' },
  { year: 1982, type: 'estancia', title: 'Estancia formativa', venue: 'Hamburgo, Alemania' },
  { year: 1980, type: 'estancia', title: 'Estancia formativa', venue: 'Bruselas, Bélgica' },
  { year: 1979, type: 'estancia', title: 'Estancia formativa', venue: 'París, Francia' },
  { year: 1974, type: 'estancia', title: 'Estancia formativa', venue: 'País Vasco, España' },
  { year: 1973, type: 'estancia', title: 'Estancia formativa', venue: 'Venezuela y Colombia' },
  { year: 1969, type: 'estancia', title: 'Estancia formativa', venue: 'Madrid, España' },
  { year: 1968, type: 'estancia', title: 'Estancia formativa', venue: 'Madrid, España' },
];

// Ordenar cronológicamente de más reciente a más antiguo
allEvents.sort((a, b) => b.year - a.year);

// Agrupar por años
const eventsByYear = allEvents.reduce((acc, event) => {
  if (!acc[event.year]) {
    acc[event.year] = [];
  }
  acc[event.year].push(event);
  return acc;
}, {});

// Obtener lista de años para el IntersectionObserver
const years = Object.keys(eventsByYear).sort((a, b) => b - a);

// SVG icons as raw strings for inline rendering
const icons = {
  // Brush/palette — exposición
  expo: `<svg class="w-5 h-5 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.9 0 1.5-.7 1.5-1.5 0-.4-.1-.7-.4-1-.3-.3-.4-.7-.4-1 0-.8.7-1.5 1.5-1.5H16c3.3 0 6-2.7 6-6 0-5.5-4.5-9-10-9z"/><circle cx="7.5" cy="11.5" r="1.5"/><circle cx="10.5" cy="7.5" r="1.5"/><circle cx="16.5" cy="11.5" r="1.5"/><circle cx="13.5" cy="7.5" r="1.5"/></svg>`,
  // Star — certamen/premio
  certamen: `<svg class="w-5 h-5 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>`,
  // Compass — estancia formativa
  estancia: `<svg class="w-5 h-5 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>`,
};
---

<Base
  title="Pedro Marco — Biografía del artista"
  description="Biografía de Pedro Marco (Villena, 1949-2022), pintor autodidacta especializado en surrealismo y grabado."
  jsonLd={jsonLd}
>
  <!-- Biografía -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="text-3xl font-bold mb-8">{t('about.title')}</h1>
    <div class="sm:flex gap-8 items-start">
      <img src="/pedro-marco-retrato.jpg" alt="Pedro Marco" class="w-full sm:w-64 lg:w-72 shrink-0 rounded-lg mb-6 sm:mb-0 object-cover" />
    <div class="prose prose-gray max-w-none text-gray-600 leading-relaxed space-y-4">
      <p>
        Pedro Marco (Villena, Alicante, 1949 – 2022) se dedicó por completo a las artes plásticas desde el año 1972. Se definía como autodidacta de formación, pero desde muy temprano destacaron sus habilidades para el dibujo. Esa destreza le incitó a formarse en academias privadas, llegando a convertirse en un dibujante excelente. En 1982 le otorgaron una beca para realizar estudios de arte en Hamburgo (Alemania), donde se especializó en la técnica del grabado.
      </p>
      <p>
        Su afán de búsqueda y conocimiento le llevaron a descubrir nuevas culturas y a recorrer países como Venezuela, Bélgica, Francia, Alemania, Italia, Reino Unido, Jordania, Siria, Argelia y Estados Unidos. Lugares de los que fue extrayendo material suficiente para crear sus composiciones.
      </p>
      <p>
        Su primera exposición individual la realizó con tan solo diecisiete años en su ciudad natal, y a partir de ese momento un sinfín de exposiciones individuales y colectivas se han ido sucediendo tanto en el ámbito nacional como en el internacional. Villena, Caracas, Madrid, San Sebastián, Murcia, Alicante, París, Barcelona, Florencia y Londres han sido algunas de las ciudades donde se han podido admirar sus creaciones, siempre rodeadas de un halo de surrealismo y fantasía. Sus obras han sido adquiridas por instituciones públicas y privadas, y han sido seleccionadas y premiadas en numerosos certámenes de pintura.
      </p>
    </div>
    </div>
  </div>

  <!-- Timeline Scrollytelling -->
  <section class="bg-amber-50/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Layout Desktop: Panel izquierdo sticky + Timeline derecho -->
      <div class="hidden sm:flex min-h-screen">
        <!-- Panel izquierdo sticky (60%) -->
        <div class="w-3/5 sticky top-16 self-start h-[calc(100vh-4rem)] flex flex-col justify-start pt-12 pl-4 lg:pl-12">
          <p class="text-sm font-semibold uppercase tracking-widest text-amber-800/60 mb-2">Trayectoria</p>
          <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 leading-tight mb-12">Toda una vida<br/>dedicada al arte</h2>
          <div id="current-year" class="text-[10rem] lg:text-[14rem] font-black text-amber-900/15 leading-none transition-opacity duration-500">
            {years[0]}
          </div>
          <!-- Miniaturas de obras del año activo -->
          <div id="year-thumbs" class="mt-6 transition-opacity duration-500">
            {years.map((year) => (
              <div class="year-thumbs-group hidden" data-thumbs-year={year}>
                <div class="grid grid-cols-5 gap-2 max-w-[28rem]">
                  {(obrasByYear[year] || []).map((obra) => (
                    <a href={`/es/obra/${obra.id}`} title={obra.titulo} class="block aspect-square rounded-md overflow-hidden border border-amber-200/50 hover:border-amber-400 hover:scale-110 transition-all duration-200 shadow-sm hover:shadow-md">
                      <img src={`/obras/thumbs/${obra.imagen}`} alt={obra.titulo} class="w-full h-full object-cover" loading="lazy" />
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Timeline derecho (40%) -->
        <div class="w-2/5 pt-32 pb-[50vh]">
          <div class="relative">
            <!-- Línea vertical -->
            <div class="absolute left-6 top-0 bottom-0 w-0.5 bg-gray-600"></div>

            {years.map((year, i) => (
              <div class={`year-section mb-24 opacity-30 transition-opacity duration-500 ${i === 0 ? 'mt-16' : ''}`} data-year={year}>
                <!-- Punto del año en la línea -->
                <div class="year-dot absolute left-4 w-5 h-5 rounded-full border-4 border-white bg-amber-300/50 transition-all duration-300" data-year={year}></div>
                
                <!-- Eventos del año -->
                <div class="ml-16">
                  <div class="space-y-6">
                    {eventsByYear[year].map((event) => (
                      <div class="flex items-start gap-3">
                        <span class="shrink-0 mt-0.5" set:html={icons[event.type] || icons.expo} />
                        <div class="min-w-0 flex-1">
                          <h4 class="text-lg font-medium text-gray-900 leading-tight">{event.title}</h4>
                          {event.venue && (
                            <p class="text-base text-gray-500 mt-1">{event.venue}</p>
                          )}
                          {event.note && (
                            <span class="inline-block mt-2 text-xs font-medium px-2 py-1 rounded-full bg-amber-50 text-amber-700 border border-amber-200">
                              {event.note}
                            </span>
                          )}
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Layout Mobile (< 640px): Año sticky en top bar + Timeline vertical -->
      <div class="sm:hidden">
        <!-- Año sticky en top bar mobile -->
        <div class="sticky top-16 z-40 bg-amber-50/80 backdrop-blur-md border-b border-amber-100 py-3">
          <div class="text-center">
            <div id="current-year-mobile" class="text-2xl font-black text-amber-900 transition-opacity duration-500">
              {years[0]}
            </div>
            <p class="text-xs text-gray-600">Trayectoria artística</p>
          </div>
          <!-- Miniaturas mobile -->
          <div id="year-thumbs-mobile" class="mt-2 flex gap-1.5 overflow-x-auto px-3 pb-1 justify-center">
            {years.map((year) => (
              <div class="year-thumbs-group-mobile hidden flex gap-1.5 shrink-0" data-thumbs-year={year}>
                {(obrasByYear[year] || []).map((obra) => (
                  <a href={`/es/obra/${obra.id}`} title={obra.titulo} class="block w-10 h-10 rounded overflow-hidden border border-amber-200/50 shrink-0">
                    <img src={`/obras/thumbs/${obra.imagen}`} alt={obra.titulo} class="w-full h-full object-cover" loading="lazy" />
                  </a>
                ))}
              </div>
            ))}
          </div>
        </div>

        <!-- Timeline mobile -->
        <div class="py-8">
          <div class="relative">
            <!-- Línea vertical -->
            <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-gray-600"></div>
            
            {years.map((year, i) => (
              <div class={`year-section-mobile mb-12 ${i === 0 ? 'mt-8' : ''}`} data-year={year}>
                <!-- Punto del año en la línea -->
                <div class="absolute left-2 w-4 h-4 bg-amber-400 rounded-full border-4 border-white shadow-sm"></div>
                
                <!-- Eventos del año -->
                <div class="ml-12">
                  <h3 class="text-lg font-bold text-gray-900 mb-4">{year}</h3>
                  <div class="space-y-3">
                    {eventsByYear[year].map((event) => (
                      <div class="bg-white rounded-lg p-3 shadow-sm border border-amber-100/50">
                        <div class="flex items-start gap-2">
                          <span class="shrink-0 mt-0.5" set:html={icons[event.type] || icons.expo} />
                          <div class="min-w-0 flex-1">
                            <h4 class="font-medium text-gray-900 text-sm leading-tight">{event.title}</h4>
                            {event.venue && (
                              <p class="text-xs text-gray-600 mt-1">{event.venue}</p>
                            )}
                            {event.note && (
                              <span class="inline-block mt-1 text-xs font-medium px-1.5 py-0.5 rounded-full bg-amber-50 text-amber-700 border border-amber-200">
                                {event.note}
                              </span>
                            )}
                          </div>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- IntersectionObserver Script -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      const currentYearDesktop = document.getElementById('current-year');
      const currentYearMobile = document.getElementById('current-year-mobile');
      const yearSections = document.querySelectorAll('.year-section');
      const yearSectionsMobile = document.querySelectorAll('.year-section-mobile');

      const allDots = document.querySelectorAll('.year-dot');

      // Thumbs groups
      var thumbGroups = document.querySelectorAll('.year-thumbs-group');
      var thumbGroupsMobile = document.querySelectorAll('.year-thumbs-group-mobile');

      function activateYear(year) {
        // Actualizar año desktop
        if (currentYearDesktop) {
          currentYearDesktop.style.opacity = '0.3';
          setTimeout(() => {
            currentYearDesktop.textContent = year;
            currentYearDesktop.style.opacity = '1';
          }, 150);
        }

        // Actualizar año mobile
        if (currentYearMobile) {
          currentYearMobile.style.opacity = '0.3';
          setTimeout(() => {
            currentYearMobile.textContent = year;
            currentYearMobile.style.opacity = '1';
          }, 150);
        }

        // Mostrar miniaturas del año activo
        thumbGroups.forEach(function(g) {
          if (g.getAttribute('data-thumbs-year') === year) {
            g.classList.remove('hidden');
            g.classList.add('flex');
          } else {
            g.classList.add('hidden');
            g.classList.remove('flex');
          }
        });
        thumbGroupsMobile.forEach(function(g) {
          if (g.getAttribute('data-thumbs-year') === year) {
            g.classList.remove('hidden');
          } else {
            g.classList.add('hidden');
          }
        });

        // Iluminar punto activo + opacidad secciones
        allDots.forEach(dot => {
          if (dot.getAttribute('data-year') === year) {
            dot.style.backgroundColor = '#92400e';
            dot.style.boxShadow = '0 0 12px rgba(146, 64, 14, 0.5)';
            dot.style.transform = 'scale(1.3)';
          } else {
            dot.style.backgroundColor = '';
            dot.style.boxShadow = '';
            dot.style.transform = '';
          }
        });
        yearSections.forEach(section => {
          section.style.opacity = section.getAttribute('data-year') === year ? '1' : '0.3';
        });
      }

      // Pausar observer durante scroll programático
      var isProgrammaticScroll = false;

      // Configurar IntersectionObserver
      const observer = new IntersectionObserver(
        (entries) => {
          if (isProgrammaticScroll) return;
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              activateYear(entry.target.getAttribute('data-year'));
            }
          });
        },
        {
          threshold: 0.3,
          rootMargin: '-20% 0px -60% 0px'
        }
      );

      // Observar secciones desktop
      yearSections.forEach((section) => {
        observer.observe(section);
      });

      // Observar secciones mobile
      yearSectionsMobile.forEach((section) => {
        observer.observe(section);
      });

      // Click en hitos: scroll a zona activa del observer (~25% del viewport)
      var allClickable = document.querySelectorAll('.year-section, .year-section-mobile');
      allClickable.forEach(function(section) {
        section.style.cursor = 'pointer';
        section.addEventListener('click', function() {
          var year = section.getAttribute('data-year');
          isProgrammaticScroll = true;
          activateYear(year);

          // Posicionar el elemento al 25% del viewport (dentro de la zona del observer)
          var rect = section.getBoundingClientRect();
          var targetY = window.scrollY + rect.top - (window.innerHeight * 0.25);
          window.scrollTo({ top: targetY, behavior: 'smooth' });

          // Reactivar observer cuando termine el scroll
          var scrollTimeout;
          function onScrollEnd() {
            clearTimeout(scrollTimeout);
            scrollTimeout = setTimeout(function() {
              isProgrammaticScroll = false;
              window.removeEventListener('scroll', onScrollEnd);
            }, 150);
          }
          window.addEventListener('scroll', onScrollEnd);
          // Fallback por si el scroll ya terminó (elemento ya visible)
          setTimeout(function() {
            isProgrammaticScroll = false;
          }, 1000);
        });
      });
    });
  </script>
</Base>
