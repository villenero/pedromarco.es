---
import Base from '../../layouts/Base.astro';
import { t } from '../../i18n/utils';
---

<Base
  title="Contacto — Pedro Marco"
  description="Contacta con la familia de Pedro Marco para consultas sobre su obra, exposiciones o adquisiciones."
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="text-3xl font-bold mb-8">{t('contact.title')}</h1>
    <div class="text-gray-600 space-y-4">
      <p>Puede contactar con la familia del artista en <a href="mailto:pedromarco@pedromarco.es" class="text-amber-800 underline hover:text-amber-900 transition-colors">pedromarco@pedromarco.es</a></p>
    </div>
  </div>
</Base>
