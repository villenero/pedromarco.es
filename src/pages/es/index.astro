---
import Base from '../../layouts/Base.astro';
import { t } from '../../i18n/utils';
import obras from '../../../obras.json';

const lang = 'es';
const categorias = [...new Set(obras.obras.map(o => o.categoria))];
---

<Base title={t(lang, 'home.title')} lang={lang}>
  <!-- Filter bar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <div class="flex flex-wrap gap-2">
      <button class="filter-btn active px-4 py-2 text-sm rounded-full border border-gray-300 transition-colors hover:bg-gray-900 hover:text-white" data-category="all">
        {t(lang, 'home.all')}
      </button>
      {categorias.map(cat => (
        <button class="filter-btn px-4 py-2 text-sm rounded-full border border-gray-300 transition-colors hover:bg-gray-900 hover:text-white capitalize" data-category={cat}>
          {cat}
        </button>
      ))}
    </div>
  </div>

  <!-- Masonry grid -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
    <div id="masonry" class="columns-2 sm:columns-3 lg:columns-4 xl:columns-5 gap-4 [column-fill:_balance]">
      {obras.obras.map(obra => (
        <a
          href={`/es/obra/${obra.id}`}
          class="masonry-item block mb-4 break-inside-avoid group relative overflow-hidden rounded-lg"
          data-category={obra.categoria}
        >
          <!-- Placeholder bg while no real images -->
          <div class="aspect-[3/4] bg-gradient-to-br from-gray-200 to-gray-300 flex items-center justify-center text-gray-500 text-sm">
            {obra.imagen}
          </div>

          <!-- Hover overlay -->
          <div class="absolute inset-0 bg-black/0 group-hover:bg-black/50 transition-colors duration-300 flex items-end">
            <div class="p-4 text-white opacity-0 group-hover:opacity-100 transition-opacity duration-300 translate-y-2 group-hover:translate-y-0">
              <p class="font-semibold">{obra.titulo[lang]}</p>
              <p class="text-sm text-white/70">{obra.año} · {obra.tecnica[lang]}</p>
              {obra.en_venta && <span class="inline-block mt-1 text-xs bg-white/20 px-2 py-0.5 rounded-full">{t(lang, 'home.for_sale')}</span>}
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</Base>

<style>
  .filter-btn.active {
    background-color: #111;
    color: white;
    border-color: #111;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll('.filter-btn');
    const items = document.querySelectorAll('.masonry-item');

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        buttons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const cat = btn.getAttribute('data-category');
        items.forEach(item => {
          if (cat === 'all' || item.getAttribute('data-category') === cat) {
            (item as HTMLElement).style.display = '';
          } else {
            (item as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  });
</script>
