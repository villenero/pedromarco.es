---
import Base from '../../layouts/Base.astro';
import { t } from '../../i18n/utils';
import obras from '../../../obras.json';
import fs from 'node:fs';
import path from 'node:path';

const categorias = [...new Set(obras.obras.map(o => o.categoria))];
const categoriaCounts: Record<string, number> = {};
for (const o of obras.obras) {
  categoriaCounts[o.categoria] = (categoriaCounts[o.categoria] || 0) + 1;
}

// Build-time: scan public/obras/ for detail images per obra
const obrasDir = path.resolve('public/obras');
const allFiles = fs.readdirSync(obrasDir).filter(f => fs.statSync(path.join(obrasDir, f)).isFile());
const detailImagesMap: Record<string, string[]> = {};
for (const obra of obras.obras) {
  const ext = path.extname(obra.imagen);
  const base = path.basename(obra.imagen, ext);
  const pattern = new RegExp(`^${base.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}_(\\d{2})${ext.replace('.', '\\.')}$`, 'i');
  const details = allFiles
    .filter(f => pattern.test(f))
    .sort();
  if (details.length > 0) {
    detailImagesMap[obra.id] = details;
  }
}

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "name": "Pedro Marco",
      "birthDate": "1949",
      "deathDate": "2022",
      "birthPlace": { "@type": "Place", "name": "Villena, Alicante, España" },
      "nationality": "Española",
      "jobTitle": "Pintor",
      "description": "Pintor surrealista autodidacta de Villena (Alicante), especializado en grabado y artes plásticas."
    },
    {
      "@type": "ImageGallery",
      "name": "Obra completa de Pedro Marco",
      "description": "Galería de obras del pintor surrealista Pedro Marco (Villena, 1949-2022).",
      "numberOfItems": obras.obras.length,
      "url": "https://pedromarco.es/es/"
    }
  ]
};
---

<Base
  title="Pedro Marco — Pintor surrealista de Villena | Obra completa"
  description="Obra completa de Pedro Marco, pintor surrealista de Villena (Alicante). Abstracto, retrato, paisaje y figurativo."
  jsonLd={jsonLd}
>
  <!-- Filter bar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <div class="flex flex-wrap gap-1">
      <button class="filter-btn px-3 py-1 text-sm rounded-full border border-transparent transition-colors hover:text-gray-900" data-category="all">
        {t('home.all')} <span class="badge">{obras.obras.length}</span>
      </button>
      {categorias.map(cat => (
        <button class={`filter-btn px-3 py-1 text-sm rounded-full border border-transparent transition-colors hover:text-gray-900 capitalize${cat === 'Cuadros' ? ' active' : ''}`} data-category={cat}>
          {cat} <span class="badge">{categoriaCounts[cat]}</span>
        </button>
      ))}
    </div>
  </div>

  <!-- Masonry grid -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
    <div id="masonry" class="columns-2 sm:columns-3 lg:columns-4 xl:columns-5 gap-2 [column-fill:_balance]">
      {obras.obras.map((obra, i) => (
        <div
          class="masonry-item obra-fade block mb-2 break-inside-avoid group relative overflow-hidden cursor-pointer"
          data-category={obra.categoria}
          data-index={i}
          style={obra.categoria !== 'Cuadros' ? 'display:none' : ''}
        >
          <img
            src={`/obras/thumbs/${obra.imagen}`}
            alt={obra.titulo}
            class="w-full h-auto object-cover bg-gray-100"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-black/0 group-hover:bg-black/50 transition-colors duration-300 flex items-end">
            <div class="p-4 text-white opacity-0 group-hover:opacity-100 transition-opacity duration-300 translate-y-2 group-hover:translate-y-0">
              <p class="font-semibold">{obra.titulo}</p>
              <p class="text-sm text-white/70">{obra.año} · {obra.tecnica}</p>
              {obra.en_venta && <span class="inline-block mt-1 text-xs bg-white/20 px-2 py-0.5 rounded-full">{t('home.for_sale')}</span>}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Modal -->
  <div id="modal" class="modal-overlay" aria-hidden="true">
    <div class="modal-backdrop"></div>

    <!-- Close -->
    <button class="modal-close" id="modal-close" aria-label="Cerrar">&times;</button>

    <!-- Prev / Next -->
    <button class="modal-nav modal-prev" id="modal-prev" aria-label="Anterior">&#8249;</button>
    <button class="modal-nav modal-next" id="modal-next" aria-label="Siguiente">&#8250;</button>

    <!-- Content -->
    <div class="modal-content" id="modal-content">
      <div class="modal-image-wrap">
        <img id="modal-img" src="" alt="" class="modal-image" />
        <!-- Zoom bar -->
        <div class="modal-zoom">
          <span class="modal-zoom-label">100%</span>
          <input type="range" id="modal-zoom" min="100" max="300" value="100" step="10" />
        </div>
      </div>
      <div class="modal-info" id="modal-info"></div>
    </div>

    <!-- Share popover (outside modal-info to avoid innerHTML resets) -->
    <div class="share-popover" id="share-popover" style="display:none">
      <div class="share-popover-arrow"></div>
      <span class="share-popover-title">Compartir obra</span>
      <a class="share-opt" href="#" id="share-wa" target="_blank" rel="noopener">
        <span class="share-opt-icon share-opt-wa">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="#fff"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        </span>
        <span>WhatsApp</span>
      </a>
      <button class="share-opt" id="share-copy">
        <span class="share-opt-icon share-opt-copy">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
        </span>
        <span>Copiar enlace</span>
      </button>
      <button class="share-opt" id="share-fullscreen">
        <span class="share-opt-icon share-opt-fs">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/></svg>
        </span>
        <span>Página</span>
      </button>
    </div>
  </div>

  <script is:inline define:vars={{ obrasData: obras.obras, detailImagesMap }}>
    const labels = {
      year: 'Año',
      technique: 'Técnica',
      dimensions: 'Dimensiones',
      owner: 'Propietario',
      for_sale: 'Disponible',
      not_for_sale: 'No está en venta'
    };

    let currentIndex = -1;
    const modal = document.getElementById('modal');
    const modalImg = document.getElementById('modal-img');
    const modalInfo = document.getElementById('modal-info');
    const modalZoom = document.getElementById('modal-zoom');
    const zoomLabel = document.querySelector('.modal-zoom-label');

    function getVisibleItems() {
      return [...document.querySelectorAll('.masonry-item')].filter(el => el.style.display !== 'none');
    }

    function resetViewer() {
      modalImg.style.transform = 'scale(1)';
      modalImg.style.cursor = 'default';
      modalZoom.value = 100;
      zoomLabel.textContent = '100%';
      resetDrag();
    }

    function switchImage(src) {
      modalImg.src = src;
      resetViewer();
    }

    function openModal(index) {
      const visibleItems = getVisibleItems();
      currentIndex = index;
      const dataIndex = parseInt(visibleItems[index].getAttribute('data-index'));
      const obra = obrasData[dataIndex];
      if (!obra) return;

      const titulo = obra.titulo || '';
      const tecnica = obra.tecnica;
      const descripcion = obra.descripcion;

      modalImg.src = `/obras/${obra.imagen}`;
      modalImg.alt = titulo;
      resetViewer();
      if (window.innerWidth <= 768) {
        modalInfo.classList.add('mobile-info-visible');
      }

      const details = detailImagesMap[obra.id] || [];
      let thumbsHtml = '';
      if (details.length > 0) {
        const allImages = [obra.imagen, ...details];
        thumbsHtml = `<div class="detail-section"><h3 class="detail-section-title">Detalles</h3><div class="detail-thumbs">${allImages.map((img, i) =>
          `<div class="detail-thumb${i === 0 ? ' active' : ''}" data-src="/obras/${img}">` +
          `<img data-lazy-src="/obras/${img}" alt="" width="60" height="60" />` +
          `</div>`
        ).join('')}</div></div>`;
      }

      const obraUrl = '/es/obra/' + obra.id;
      modalInfo.innerHTML = `
        <div class="flex items-start justify-between gap-3 mb-4">
          <h2 class="text-2xl font-bold">${titulo}</h2>
          <button class="share-trigger" title="Compartir" aria-label="Compartir">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/></svg>
          </button>
        </div>
        <div class="space-y-3 text-sm">
          ${obra.año ? `<div><span class="text-gray-400 block">${labels.year}</span><span class="font-medium">${obra.año}</span></div>` : ''}
          ${tecnica && tecnica !== 'No definido' ? `<div><span class="text-gray-400 block">${labels.technique}</span><span class="font-medium">${tecnica}</span></div>` : ''}
          ${obra.dimensiones && obra.dimensiones !== 'No definido' ? `<div><span class="text-gray-400 block">${labels.dimensions}</span><span class="font-medium">${obra.dimensiones}</span></div>` : ''}
          ${obra.propietario ? `<div><span class="text-gray-400 block">${labels.owner}</span><span class="font-medium">${obra.propietario}</span></div>` : ''}
        </div>
        ${descripcion && descripcion !== 'No definido' ? `<p class="text-gray-600 leading-relaxed mt-4">${descripcion}</p>` : ''}
        ${thumbsHtml}
        <div class="mt-4">
          ${obra.en_venta
            ? `<span class="inline-flex items-center gap-2.5 text-sm font-medium text-green-700 bg-green-50 px-3 py-1.5 rounded-full">&#9679; ${labels.for_sale}</span>`
            : ''}
        </div>
      `;

      // Lazy-load detail thumbnails
      modalInfo.querySelectorAll('.detail-thumb img[data-lazy-src]').forEach(img => {
        img.src = img.getAttribute('data-lazy-src');
      });

      // Thumbnail click handlers
      modalInfo.querySelectorAll('.detail-thumb').forEach(thumb => {
        thumb.addEventListener('click', () => {
          modalInfo.querySelectorAll('.detail-thumb').forEach(t => t.classList.remove('active'));
          thumb.classList.add('active');
          switchImage(thumb.getAttribute('data-src'));
        });
      });

      // Share popover handler
      var shareTrigger = modalInfo.querySelector('.share-trigger');
      var popover = document.getElementById('share-popover');
      var shareWa = document.getElementById('share-wa');
      var shareCopy = document.getElementById('share-copy');
      var fullUrl = window.location.origin + obraUrl;

      if (shareTrigger) {
        shareTrigger.addEventListener('click', function(e) {
          e.stopPropagation();
          var isOpen = popover.style.display !== 'none';
          popover.style.display = isOpen ? 'none' : 'flex';
          if (!isOpen) {
            var rect = shareTrigger.getBoundingClientRect();
            var modalRect = modal.getBoundingClientRect();
            popover.style.position = 'fixed';
            popover.style.top = (rect.bottom + 8) + 'px';
            popover.style.right = (modalRect.right - rect.right) + 'px';
            popover.style.left = 'auto';
          }
        });
      }
      if (shareWa) {
        shareWa.href = 'https://wa.me/?text=' + encodeURIComponent(titulo + ' — Pedro Marco\n' + fullUrl);
      }
      if (shareCopy) {
        shareCopy.onclick = function() {
          var label = shareCopy.querySelector('span:last-child');
          navigator.clipboard.writeText(fullUrl).then(function() {
            label.textContent = '¡Copiado!';
            shareCopy.classList.add('copied');
            popover.style.display = 'none';
            setTimeout(function() {
              label.textContent = 'Copiar enlace';
              shareCopy.classList.remove('copied');
            }, 2000);
          });
        };
      }
      var shareFs = document.getElementById('share-fullscreen');
      if (shareFs) {
        shareFs.onclick = function() {
          popover.style.display = 'none';
          window.open(obraUrl, '_blank');
        };
      }

      modal.classList.add('open');
      document.body.style.overflow = 'hidden';
      if (window.innerWidth <= 768) {
        document.body.style.touchAction = 'none';
      }
    }

    function closeModal() {
      modal.classList.remove('open');
      modalInfo.classList.remove('mobile-info-visible');
      var pop = document.getElementById('share-popover');
      if (pop) pop.style.display = 'none';
      document.body.style.overflow = '';
      document.body.style.touchAction = '';
      document.body.style.webkitOverflowScrolling = '';
      const mc = document.getElementById('modal-content');
      mc.style.transform = '';
      mc.style.opacity = '';
      mc.style.transition = '';
      // Force layout recalc on mobile to restore scrolling
      if (window.innerWidth <= 768) {
        window.scrollTo(window.scrollX, window.scrollY);
      }
    }

    function navigate(dir) {
      const visibleItems = getVisibleItems();
      const next = currentIndex + dir;
      if (next >= 0 && next < visibleItems.length) openModal(next);
    }

    // Click on gallery items
    document.querySelectorAll('.masonry-item').forEach(item => {
      item.addEventListener('click', () => {
        const visibleItems = getVisibleItems();
        const idx = visibleItems.indexOf(item);
        if (idx !== -1) openModal(idx);
      });
    });

    // Close
    document.getElementById('modal-close').addEventListener('click', closeModal);
    document.querySelector('.modal-backdrop').addEventListener('click', closeModal);

    // Close share popover on click outside
    document.addEventListener('click', function(e) {
      var pop = document.getElementById('share-popover');
      if (pop && pop.style.display !== 'none' && !e.target.closest('.share-trigger') && !e.target.closest('.share-popover')) {
        pop.style.display = 'none';
      }
    });
    document.addEventListener('keydown', (e) => {
      if (!modal.classList.contains('open')) return;
      if (e.key === 'Escape') closeModal();
      if (e.key === 'ArrowLeft') navigate(-1);
      if (e.key === 'ArrowRight') navigate(1);
    });

    // Nav
    document.getElementById('modal-prev').addEventListener('click', () => navigate(-1));
    document.getElementById('modal-next').addEventListener('click', () => navigate(1));

    // Zoom + drag
    let dragX = 0, dragY = 0, isDragging = false, startX = 0, startY = 0;

    function applyTransform() {
      const scale = modalZoom.value / 100;
      modalImg.style.transform = `translate(${dragX}px, ${dragY}px) scale(${scale})`;
    }

    function resetDrag() {
      dragX = 0; dragY = 0;
      isDragging = false;
    }

    modalZoom.addEventListener('input', (e) => {
      const val = e.target.value;
      zoomLabel.textContent = val + '%';
      if (val == 100) resetDrag();
      applyTransform();
      modalImg.style.cursor = val > 100 ? 'grab' : 'default';
    });

    modalImg.addEventListener('mousedown', (e) => {
      if (modalZoom.value <= 100) return;
      isDragging = true;
      startX = e.clientX - dragX;
      startY = e.clientY - dragY;
      modalImg.style.cursor = 'grabbing';
      modalImg.style.transition = 'none';
      e.preventDefault();
    });

    document.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      dragX = e.clientX - startX;
      dragY = e.clientY - startY;
      applyTransform();
    });

    document.addEventListener('mouseup', () => {
      if (!isDragging) return;
      isDragging = false;
      modalImg.style.cursor = 'grab';
      modalImg.style.transition = '';
    });

    // Mouse wheel zoom
    document.querySelector('.modal-image-wrap').addEventListener('wheel', (e) => {
      e.preventDefault();
      let val = parseInt(modalZoom.value) + (e.deltaY < 0 ? 10 : -10);
      val = Math.max(100, Math.min(300, val));
      modalZoom.value = val;
      zoomLabel.textContent = val + '%';
      if (val == 100) resetDrag();
      applyTransform();
      modalImg.style.cursor = val > 100 ? 'grab' : 'default';
    }, { passive: false });

    // Touch: pinch-to-zoom + drag
    let pinchStartDist = 0;
    let pinchStartScale = 1;
    let isPinching = false;

    function getTouchDist(t1, t2) {
      const dx = t1.clientX - t2.clientX;
      const dy = t1.clientY - t2.clientY;
      return Math.sqrt(dx * dx + dy * dy);
    }

    modalImg.addEventListener('touchstart', (e) => {
      if (e.touches.length === 2) {
        isPinching = true;
        isDragging = false;
        pinchStartDist = getTouchDist(e.touches[0], e.touches[1]);
        pinchStartScale = parseInt(modalZoom.value) / 100;
        modalImg.style.transition = 'none';
        e.preventDefault();
      } else if (e.touches.length === 1 && parseInt(modalZoom.value) > 100) {
        isDragging = true;
        startX = e.touches[0].clientX - dragX;
        startY = e.touches[0].clientY - dragY;
        modalImg.style.transition = 'none';
      }
    }, { passive: false });

    document.addEventListener('touchmove', (e) => {
      if (isPinching && e.touches.length === 2) {
        const dist = getTouchDist(e.touches[0], e.touches[1]);
        let newScale = pinchStartScale * (dist / pinchStartDist);
        newScale = Math.max(1, Math.min(3, newScale));
        const val = Math.round(newScale * 100);
        modalZoom.value = val;
        zoomLabel.textContent = val + '%';
        if (val <= 100) resetDrag();
        applyTransform();
        e.preventDefault();
      } else if (isDragging && e.touches.length === 1) {
        dragX = e.touches[0].clientX - startX;
        dragY = e.touches[0].clientY - startY;
        applyTransform();
      }
    }, { passive: false });

    document.addEventListener('touchend', (e) => {
      if (isPinching) {
        isPinching = false;
        modalImg.style.transition = '';
        if (parseInt(modalZoom.value) <= 100) {
          modalZoom.value = 100;
          zoomLabel.textContent = '100%';
          resetDrag();
          applyTransform();
        }
      }
      if (isDragging && e.touches.length === 0) {
        isDragging = false;
        modalImg.style.transition = '';
      }
    });

    // Mobile: swipe navigation, swipe-down close, tap to toggle info
    (function() {
      const isMobile = () => window.innerWidth <= 768;
      let touchStartX = 0, touchStartY = 0;
      let swipeDownOffset = 0;
      const modalContent = document.getElementById('modal-content');

      modalImg.addEventListener('touchstart', function(e) {
        if (!isMobile() || !modal.classList.contains('open')) return;
        if (e.touches.length !== 1 || isPinching) return;
        // Don't handle swipes when zoomed in
        if (parseInt(modalZoom.value) > 100) return;
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
        swipeDownOffset = 0;
        modalContent.style.transition = 'none';
      }, { passive: true });

      modalImg.addEventListener('touchmove', function(e) {
        if (!isMobile() || !modal.classList.contains('open')) return;
        if (e.touches.length !== 1 || isPinching) return;
        if (parseInt(modalZoom.value) > 100) return;
        const dy = e.touches[0].clientY - touchStartY;
        const dx = e.touches[0].clientX - touchStartX;
        if (dy > 0 && Math.abs(dy) > Math.abs(dx)) {
          swipeDownOffset = dy;
          modalContent.style.transform = `translateY(${dy}px)`;
          modalContent.style.opacity = Math.max(0.5, 1 - dy / 300);
        }
      }, { passive: true });

      modalImg.addEventListener('touchend', function(e) {
        if (!isMobile() || !modal.classList.contains('open')) return;
        if (isPinching) return;
        if (parseInt(modalZoom.value) > 100) return;
        const dx = e.changedTouches[0].clientX - touchStartX;
        const dy = e.changedTouches[0].clientY - touchStartY;

        modalContent.style.transform = '';
        modalContent.style.opacity = '';
        modalContent.style.transition = '';

        if (dy > 100 && Math.abs(dy) > Math.abs(dx)) {
          closeModal();
          return;
        }
        if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) {
          if (dx < 0) navigate(1);
          else navigate(-1);
          return;
        }
        if (Math.abs(dx) < 10 && Math.abs(dy) < 10) {
          modalInfo.classList.toggle('mobile-info-visible');
        }
      }, { passive: true });
    })();

    // Fade-in on scroll with random order
    // Collect visible items in batches, then reveal them in shuffled order
    let fadePending = [];
    let fadeTimer = null;
    function flushFadeBatch() {
      // Shuffle the batch randomly
      for (let i = fadePending.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [fadePending[i], fadePending[j]] = [fadePending[j], fadePending[i]];
      }
      fadePending.forEach((el, i) => {
        setTimeout(() => el.classList.add('visible'), Math.floor(i / 2) * 40);
      });
      fadePending = [];
    }
    const fadeObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          fadePending.push(entry.target);
          fadeObserver.unobserve(entry.target);
        }
      });
      if (fadePending.length > 0) {
        clearTimeout(fadeTimer);
        fadeTimer = setTimeout(flushFadeBatch, 50);
      }
    }, { threshold: 0.1 });
    document.querySelectorAll('.obra-fade').forEach(el => fadeObserver.observe(el));

    // Filter buttons
    const buttons = document.querySelectorAll('.filter-btn');
    const items = document.querySelectorAll('.masonry-item');
    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        buttons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const cat = btn.getAttribute('data-category');
        items.forEach(item => {
          item.style.display = (cat === 'all' || item.getAttribute('data-category') === cat) ? '' : 'none';
        });
      });
    });
  </script>
