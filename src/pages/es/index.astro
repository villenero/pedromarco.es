---
import Base from '../../layouts/Base.astro';
import obrasData from '../../../obras.json';

const totalObras = obrasData.obras.length;

// Featured works: random selection from obras with destacada=true (re-rolls on every build)
type Layout = 'w-hero' | 'w-tall' | 'w-med' | 'w-wide' | 'w-sq' | 'w-half';
const layouts: Layout[] = ['w-hero', 'w-tall', 'w-med', 'w-wide', 'w-sq', 'w-half', 'w-half'];

const destacadas = obrasData.obras.filter((o: any) => o.destacada && o.imagen);
const shuffled = [...destacadas].sort(() => Math.random() - 0.5);
const featured = shuffled.slice(0, layouts.length).map((obra, i) => ({ obra, layout: layouts[i] }));

const title = 'Pedro Marco — Pintor de sueños · Villena, 1949–2022';
const description = 'Obra completa de Pedro Marco Hernández, pintor autodidacta de Villena (Alicante). Surrealismo, grabado, retrato y paisaje. Medio siglo de creación entre el Mediterráneo y el Sahara.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      name: 'Pedro Marco',
      birthDate: '1949',
      deathDate: '2022',
      birthPlace: { '@type': 'Place', name: 'Villena, Alicante, España' },
      nationality: 'Española',
      jobTitle: 'Pintor',
      description:
        'Pintor de sueños autodidacta de Villena (Alicante), especializado en grabado y artes plásticas.',
      sameAs: 'https://pedromarco.es',
    },
    {
      '@type': 'WebSite',
      name: 'Pedro Marco — Pintor de sueños',
      url: 'https://pedromarco.es/es/',
      description,
      inLanguage: 'es',
      about: { '@type': 'Person', name: 'Pedro Marco' },
    },
  ],
};
---

<Base
  title={title}
  description={description}
  image="https://pedromarco.es/pedro-marco-retrato.jpg"
  jsonLd={jsonLd}
  bodyClass="landing"
>

<!-- HERO -->
<header class="hero">
  <div class="hero-grid">
    <h1 class="hero-title">
      <span class="line">Pintor</span>
      <span class="line">de <span class="em">sueños</span></span>
      <span class="line hero-subline">y de la tierra que los guarda.</span>
    </h1>
    <div class="hero-right">
      <div class="hero-portrait">
        <img src="/pedro-marco-retrato.jpg" alt="Retrato de Pedro Marco en su estudio" />
      </div>
      <p class="hero-kicker">
        Autodidacta, grabador formado en Hamburgo, viajero incansable.
        Medio siglo trazando surrealismo, fantasía y memoria —
        del Mediterráneo al Sahara, de Villena a Florencia.
      </p>
    </div>
  </div>

</header>

<!-- MANIFESTO -->
<section class="manifesto-wrap" id="manifesto">
  <div class="manifesto">
    <div class="manifesto-label">Del archivo · 1991</div>
    <blockquote class="manifesto-quote">
      <span class="mark">“</span>No pinto lo que veo;
      pinto lo que se asoma <em>cuando cierro los ojos</em>
      y me acuerdo de Villena.<span class="mark">”</span>
    </blockquote>
    <div class="manifesto-attr">Pedro Marco — 24 horas dibujando · Bar-Galería El Túnel</div>
  </div>
</section>

<!-- FEATURED WORKS -->
<section class="section" id="obra">
  <div class="featured-bar">
    <span class="label">§ 01 — Obras destacadas</span>
    <a class="link" href="/es/obras">Ver todas ({totalObras}) →</a>
  </div>

  <div class="works-grid">
    {featured.map(({ obra, layout }) => (
      <a class={`work fade-up ${layout}`} href={`/es/obra/${obra.id}`}>
        <div class="frame">
          <img src={`/obras/thumbs/${obra.imagen}`} alt={obra.titulo} loading="lazy" />
          <div class="w-cap">
            <span class="t2">{obra.titulo}</span>
            <span class="m2">{obra.año}{obra.dimensiones && obra.dimensiones !== 'No definido' ? ` · ${obra.dimensiones}` : ''}</span>
          </div>
        </div>
        <div class="info">
          <div>
            <div class="t">{obra.titulo}</div>
            {obra.tecnica && obra.tecnica !== 'No definido' && <div class="tech">{obra.tecnica}</div>}
          </div>
          <div class="meta">{obra.año}</div>
        </div>
      </a>
    ))}
  </div>
</section>

<!-- BIOGRAPHY -->
<section class="bio-wrap" id="bio">
  <div class="bio">
    <div class="bio-l">
      <div class="label">§ 02 — Biografía</div>
      <h2>Una vida <em>dedicada</em><br/>por entero al arte.</h2>
      <p>
        Pedro Marco Hernández (Villena, Alicante, 1949 – 2022) se dedicó por completo a las artes plásticas desde 1972. Autodidacta, en 1982 recibió una beca para formarse en Hamburgo, donde se especializó en la técnica del grabado.
      </p>
      <p>
        Recorrió Venezuela, Bélgica, Francia, Alemania, Italia, Reino Unido, Jordania, Siria y Argelia. De cada lugar extrajo material para composiciones envueltas en un halo de surrealismo y fantasía, con raíces firmes en su tierra.
      </p>
      <p>
        Su primera exposición individual la hizo a los 17 años, en su ciudad natal. Desde entonces expuso en Caracas, Madrid, San Sebastián, París, Barcelona, Florencia y Londres.
      </p>
      <a class="read-more" href="/es/sobre">
        Leer la biografía completa
        <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 5h6M5 2l3 3-3 3"/></svg>
      </a>
    </div>
    <div class="bio-r">
      <div class="stat">
        <div class="num">56<sup>años</sup></div>
        <div>
          <div class="s-label">De trayectoria</div>
          <div class="s-desc">De la primera exposición individual (1966) a la obra póstuma (2022).</div>
        </div>
      </div>
      <div class="stat">
        <div class="num">{totalObras}</div>
        <div>
          <div class="s-label">Obras catalogadas</div>
          <div class="s-desc">Óleo, grabado, dibujo, acuarela y técnica mixta. En constante actualización.</div>
        </div>
      </div>
      <div class="stat">
        <div class="num">32</div>
        <div>
          <div class="s-label">Exposiciones individuales</div>
          <div class="s-desc">Villena, Alicante, Madrid, Barcelona, París, Florencia, Londres, San Sebastián…</div>
        </div>
      </div>
      <div class="stat">
        <div class="num">9</div>
        <div>
          <div class="s-label">Países recorridos</div>
          <div class="s-desc">De Hamburgo al Sahara; del Mediterráneo a Petra. El viaje como taller.</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- TIMELINE TEASER -->
<section class="section" id="recorrido">
  <div class="section-head">
    <div class="section-num">§ 03 — Recorrido</div>
    <h2 class="section-title">Hitos de <em>toda una vida</em> expuesta.</h2>
  </div>

  <div class="tl-grid">
    <div>
      <div class="tl-list">
        <a class="tl-item" href="/es/recorrido">
          <span class="tl-year">2024</span>
          <span class="tl-title">Tras los Pasos de Ilici</span>
          <span class="tl-place">MACE Elche</span>
        </a>
        <a class="tl-item" href="/es/recorrido">
          <span class="tl-year">2021</span>
          <span class="tl-title">Arte Celular</span>
          <span class="tl-place">El Túnel · Villena</span>
        </a>
        <a class="tl-item" href="/es/recorrido">
          <span class="tl-year">2010</span>
          <span class="tl-title">Onirismos</span>
          <span class="tl-place">Fund. Schlotter · Altea</span>
        </a>
        <a class="tl-item" href="/es/recorrido">
          <span class="tl-year">2001</span>
          <span class="tl-title">Latitudes</span>
          <span class="tl-place">Juana Francés · Alicante</span>
        </a>
        <a class="tl-item" href="/es/recorrido">
          <span class="tl-year">1999</span>
          <span class="tl-title">Exposición individual</span>
          <span class="tl-place">L'Entrée des Artistes · Barbizon</span>
        </a>
        <a class="tl-item" href="/es/recorrido">
          <span class="tl-year">1994</span>
          <span class="tl-title">Exposición individual</span>
          <span class="tl-place">Studio D Gallery · Londres</span>
        </a>
        <a class="tl-item" href="/es/recorrido">
          <span class="tl-year">1990</span>
          <span class="tl-title">Exposición individual</span>
          <span class="tl-place">Ken's Art Gallery · Florencia</span>
        </a>
        <a class="tl-item" href="/es/recorrido">
          <span class="tl-year">1982</span>
          <span class="tl-title">Beca de grabado</span>
          <span class="tl-place">Hamburgo · Alemania</span>
        </a>
        <a class="tl-item" href="/es/recorrido">
          <span class="tl-year">1966</span>
          <span class="tl-title">Primera exposición individual</span>
          <span class="tl-place">Caja de Ahorros · Villena</span>
        </a>
      </div>
      <a class="btn secondary" href="/es/recorrido" style="margin-top: 32px;">
        Recorrido completo
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 8h10m-4-4l4 4-4 4"/></svg>
      </a>
    </div>

    <div class="tl-sticky">
      <div class="tl-visual">
        <img src="/obras/thumbs/1982 Ciudades.jpg" alt="Las ciudades no mueren" />
        <div class="tl-tag">
          <span>1982 · Hamburgo</span>
          <span>Técnica de grabado</span>
        </div>
      </div>
      <p class="tl-quote">
        “En Hamburgo aprendí que la plancha recuerda todo lo que se le hace. Así es la memoria de un pueblo.”
      </p>
    </div>
  </div>
</section>

<!-- LEGACY -->
<section class="legacy-wrap" id="legado">
  <div class="legacy">
    <div class="legacy-visual">
      <img src="/obras/thumbs/1986 Hnos Sanchez Grinan.jpg" alt="Obra en colección privada" />
      <div class="stamp">Colección privada · 1986</div>
    </div>
    <div>
      <div class="manifesto-label" style="margin-bottom: 20px;">§ 04 — Legado</div>
      <h2>¿Tienes una obra<br/><em>de Pedro?</em></h2>
      <p>
        A lo largo de 56 años, Pedro Marco creó un cuerpo de obra hoy disperso en instituciones, galerías y hogares. Cada pieza cuenta un capítulo — muchos todavía sin catalogar.
      </p>
      <div class="help-card">
        <img src="/favicon.png" alt="" class="snail" />
        <div>
          <strong>Una foto basta.</strong>
          <span>Desde el móvil, con cualquier detalle que conozcas: dueño actual, año, procedencia. Nosotros completamos el resto.</span>
        </div>
      </div>
      <div class="hero-cta-row">
        <a class="btn" href="/es/contacto">
          Quiero colaborar
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 8h10m-4-4l4 4-4 4"/></svg>
        </a>
        <a class="btn secondary" href="/es/colecciones">Ver colecciones</a>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function() {
    if (!('IntersectionObserver' in window)) return;
    var io = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, { threshold: 0.1 });
    document.querySelectorAll('.fade-up').forEach(function(el) { io.observe(el); });
  })();
</script>

<style is:global>
  /* ---------- LANDING: HERO ---------- */
  body.landing .hero { position: relative; max-width: 1280px; margin: 0 auto; padding: 40px 32px 120px; }
  body.landing .hero-grid { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 48px; align-items: end; }
  @media (max-width: 900px) { body.landing .hero-grid { grid-template-columns: 1fr; } }
  body.landing .hero-title {
    font-family: var(--serif); font-weight: 400;
    font-size: clamp(64px, 11vw, 168px);
    line-height: 0.88; letter-spacing: -0.02em;
    color: var(--ink); margin: 0;
  }
  body.landing .hero-title .line { display: block; }
  body.landing .hero-title .em { font-style: italic; color: var(--accent); font-weight: 500; }
  body.landing .hero-title .hero-subline {
    font-size: 0.42em; color: var(--ink-soft); font-style: italic;
    letter-spacing: 0; padding-top: .4em;
  }

  body.landing .hero-right { display: flex; flex-direction: column; gap: 24px; align-items: flex-start; }
  body.landing .hero-portrait {
    position: relative; width: 100%; aspect-ratio: 4 / 5;
    background: var(--bg-deep); overflow: hidden; border-radius: 2px;
  }
  body.landing .hero-portrait img {
    width: 100%; height: 100%;
    object-fit: cover; object-position: center 30%;
    filter: contrast(1.02) saturate(0.9);
  }
  body.landing .hero-portrait::after {
    content: ""; position: absolute; inset: 0;
    background: linear-gradient(170deg, transparent 60%, rgba(42,33,27,0.15));
    pointer-events: none;
  }
  body.landing .portrait-caption {
    display: flex; justify-content: space-between; width: 100%;
    font-family: var(--mono); font-size: 10px;
    letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--ink-faint);
  }
  body.landing .hero-kicker {
    font-family: var(--serif); font-style: italic;
    font-size: clamp(18px, 2vw, 22px); line-height: 1.45;
    color: var(--ink-soft); max-width: 42ch; margin: 0;
  }

  body.landing .hero-cta-row { display: flex; gap: 12px; flex-wrap: wrap; }
  body.landing .btn {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 14px 22px; border-radius: 999px;
    font-size: 14px; font-weight: 500;
    transition: all .2s; cursor: pointer;
    border: 1px solid var(--ink);
    background: var(--ink); color: var(--bg);
    font-family: var(--sans);
    text-decoration: none;
  }
  body.landing .btn:hover { background: var(--accent); border-color: var(--accent); color: var(--bg); transform: translateY(-1px); }
  body.landing .btn.secondary { background: transparent; color: var(--ink); }
  body.landing .btn.secondary:hover { background: var(--ink); color: var(--bg); }
  body.landing .btn svg { width: 14px; height: 14px; }

  /* ---------- LANDING: SECTION FRAME ---------- */
  body.landing .section { max-width: 1280px; margin: 0 auto; padding: 120px 32px; position: relative; }
  body.landing .section-head { display: grid; grid-template-columns: 200px 1fr; gap: 40px; margin-bottom: 64px; }
  @media (max-width: 780px) {
    body.landing .section { padding: 80px 20px; }
    body.landing .section-head { grid-template-columns: 1fr; gap: 16px; margin-bottom: 40px; }
  }
  body.landing .section-num {
    font-family: var(--mono); font-size: 11px;
    letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--ink-faint);
  }
  body.landing .section-title {
    font-family: var(--serif); font-weight: 400;
    font-size: clamp(36px, 5vw, 64px); line-height: 1.02;
    letter-spacing: -0.015em; margin: 0; color: var(--ink);
  }
  body.landing .section-title em { color: var(--accent); font-weight: 500; font-style: italic; }

  /* ---------- LANDING: MANIFESTO ---------- */
  body.landing .manifesto-wrap {
    background: var(--bg-warm);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  body.landing .manifesto { max-width: 1100px; margin: 0 auto; padding: 140px 32px; text-align: center; }
  @media (max-width: 780px) { body.landing .manifesto { padding: 80px 20px; } }
  body.landing .manifesto-label {
    font-family: var(--mono); font-size: 11px;
    letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--accent); margin-bottom: 32px;
  }
  body.landing .manifesto-quote {
    font-family: var(--serif); font-style: italic; font-weight: 400;
    font-size: clamp(28px, 4.2vw, 54px); line-height: 1.18;
    letter-spacing: -0.01em; color: var(--ink); margin: 0 0 32px;
  }
  body.landing .manifesto-quote em { font-style: italic; color: var(--accent); font-weight: 500; }
  body.landing .manifesto-quote .mark {
    color: var(--accent); font-size: 1.3em;
    vertical-align: -0.12em; line-height: 0; padding: 0 .08em;
  }
  body.landing .manifesto-attr {
    font-size: 13px; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--ink-soft);
  }

  /* ---------- LANDING: FEATURED WORKS ---------- */
  body.landing .featured-bar {
    display: flex; justify-content: space-between; align-items: baseline;
    margin-bottom: 40px; padding-bottom: 20px;
    border-bottom: 1px solid var(--line);
  }
  body.landing .featured-bar .label {
    font-family: var(--mono); font-size: 11px;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-faint);
  }
  body.landing .featured-bar .link {
    font-size: 14px; color: var(--ink-soft);
    border-bottom: 1px solid var(--ink-faint);
    padding-bottom: 2px; transition: all .2s;
    text-decoration: none;
  }
  body.landing .featured-bar .link:hover { color: var(--accent); border-color: var(--accent); }

  body.landing .works-grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: 24px; }
  @media (max-width: 900px) { body.landing .works-grid { grid-template-columns: repeat(6, 1fr); } }
  body.landing .work {
    position: relative; display: flex; flex-direction: column;
    gap: 14px; cursor: pointer;
    transition: transform .4s cubic-bezier(.2,.7,.2,1);
    text-decoration: none;
  }
  body.landing .work:hover { transform: translateY(-4px); }
  body.landing .work .frame {
    position: relative; overflow: hidden;
    background: var(--bg-deep);
    box-shadow: 0 1px 0 rgba(0,0,0,0.04), 0 20px 40px -30px rgba(42,33,27,0.3);
    width: 100%;
  }
  body.landing .work .frame img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform .8s cubic-bezier(.2,.7,.2,1);
  }
  body.landing .work:hover .frame img { transform: scale(1.04); }
  body.landing .work .info { display: flex; justify-content: space-between; gap: 16px; align-items: baseline; }
  body.landing .work .t { font-family: var(--serif); font-size: 20px; font-style: italic; line-height: 1.2; color: var(--ink); }
  body.landing .work .meta {
    font-family: var(--mono); font-size: 10px;
    letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--ink-faint); white-space: nowrap;
  }
  body.landing .work .tech { font-size: 12px; color: var(--ink-soft); font-style: italic; }

  body.landing .work.w-hero  { grid-column: span 7; }
  body.landing .work.w-hero  .frame { aspect-ratio: 4/3; }
  body.landing .work.w-tall  { grid-column: span 5; }
  body.landing .work.w-tall  .frame { aspect-ratio: 3/4; }
  body.landing .work.w-med   { grid-column: span 4; }
  body.landing .work.w-med   .frame { aspect-ratio: 4/5; }
  body.landing .work.w-wide  { grid-column: span 8; }
  body.landing .work.w-wide  .frame { aspect-ratio: 16/10; }
  body.landing .work.w-sq    { grid-column: span 4; }
  body.landing .work.w-sq    .frame { aspect-ratio: 1/1; }
  body.landing .work.w-half  { grid-column: span 6; }
  body.landing .work.w-half  .frame { aspect-ratio: 4/3; }

  @media (max-width: 900px) {
    body.landing .work.w-hero, body.landing .work.w-wide { grid-column: span 6; }
    body.landing .work.w-tall, body.landing .work.w-med, body.landing .work.w-sq, body.landing .work.w-half { grid-column: span 3; }
  }
  @media (max-width: 560px) {
    body.landing .work.w-hero, body.landing .work.w-wide, body.landing .work.w-tall, body.landing .work.w-med, body.landing .work.w-sq, body.landing .work.w-half { grid-column: span 6; }
    body.landing .work .frame { aspect-ratio: 4/3 !important; }
  }

  body.landing .work .frame > .w-cap {
    position: absolute; inset: auto 14px 14px 14px;
    display: flex; justify-content: space-between; align-items: flex-end;
    gap: 16px; color: #fff; opacity: 0;
    transform: translateY(6px);
    transition: all .3s;
    text-shadow: 0 1px 10px rgba(0,0,0,0.5);
    pointer-events: none;
  }
  body.landing .work:hover .frame > .w-cap { opacity: 1; transform: translateY(0); }
  body.landing .work .frame::after {
    content: ""; position: absolute; inset: 0;
    background: linear-gradient(180deg, transparent 55%, rgba(0,0,0,0.45));
    opacity: 0; transition: opacity .3s; pointer-events: none;
  }
  body.landing .work:hover .frame::after { opacity: 1; }
  body.landing .w-cap .t2 { font-family: var(--serif); font-size: 22px; font-style: italic; }
  body.landing .w-cap .m2 { font-family: var(--mono); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.9; }

  /* ---------- LANDING: BIO ---------- */
  body.landing .bio-wrap { background: var(--ink); color: var(--bg); }
  body.landing .bio {
    max-width: 1280px; margin: 0 auto; padding: 140px 32px;
    display: grid; grid-template-columns: 1fr 1fr; gap: 80px;
    align-items: start;
  }
  @media (max-width: 900px) { body.landing .bio { grid-template-columns: 1fr; gap: 48px; padding: 80px 20px; } }
  body.landing .bio-l .label {
    font-family: var(--mono); font-size: 11px;
    letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--accent-soft); margin-bottom: 28px;
  }
  body.landing .bio-l h2 {
    font-family: var(--serif); font-weight: 400;
    font-size: clamp(36px, 4.8vw, 58px); line-height: 1.05;
    letter-spacing: -0.015em; margin: 0 0 40px; color: var(--bg);
  }
  body.landing .bio-l h2 em { color: var(--accent-soft); font-weight: 500; font-style: italic; }
  body.landing .bio-l p {
    font-family: var(--serif); font-size: 19px; line-height: 1.55;
    color: rgba(250, 246, 238, 0.78); margin: 0 0 20px;
  }
