---
import Base from '../../layouts/Base.astro';
---

<Base
  title="¡Gracias! — Pedro Marco"
  description="Gracias por colaborar con el catálogo de Pedro Marco."
>
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center">
    <img src="/favicon.png" alt="" class="w-16 h-16 mx-auto mb-6 opacity-60" />
    <h1 class="text-3xl font-bold text-gray-900 mb-4">¡Muchas gracias!</h1>
    <p class="text-lg text-gray-600 mb-3">
      Tu información ha sido enviada correctamente.
    </p>
    <p class="text-gray-500 mb-8">
      Revisaremos los datos y te contactaremos personalmente. Cada obra recuperada es un paso más para preservar el legado de Pedro Marco.
    </p>
    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a
        href="/es/"
        class="inline-flex items-center justify-center gap-2 bg-amber-800 text-white px-6 py-3 rounded-lg font-medium hover:bg-amber-900 transition-colors text-sm"
      >
        Ver la galería
      </a>
      <a
        href="/es/contacto"
        class="inline-flex items-center justify-center gap-2 border border-gray-300 text-gray-700 px-6 py-3 rounded-lg font-medium hover:bg-gray-50 transition-colors text-sm"
      >
        Enviar otra obra
      </a>
    </div>
    <p class="mt-10 text-sm text-gray-400 italic">
      «Su arte vive en quien lo recuerda»
    </p>
  </div>
</Base>
