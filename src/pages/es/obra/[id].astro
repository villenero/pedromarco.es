---
import Base from '../../../layouts/Base.astro';
import { t } from '../../../i18n/utils';
import data from '../../../../obras.json';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  return data.obras.map(obra => ({ params: { id: obra.id } }));
}

const { id } = Astro.params;
const obra = data.obras.find(o => o.id === id);
if (!obra) return Astro.redirect('/es/');

// Find detail/variant images (_01, _02, etc.)
const obrasDir = path.resolve('public/obras');
const ext = path.extname(obra.imagen);
const base = path.basename(obra.imagen, ext);
const pattern = new RegExp(`^${base.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}_(\\d{2})${ext.replace('.', '\\.')}$`, 'i');
const detailImages = fs.readdirSync(obrasDir)
  .filter(f => pattern.test(f) && fs.statSync(path.join(obrasDir, f)).isFile())
  .sort();

const titulo = obra.titulo || '';
const tecnica = obra.tecnica || '';
const description = `${titulo}${tecnica ? ` — ${tecnica}` : ''}${obra.año ? ` (${obra.año})` : ''}. Obra de Pedro Marco, pintor de sueños de Villena.`;
const ogImage = `https://pedromarco.es/obras/${obra.imagen}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "VisualArtwork",
  "name": titulo,
  "artist": {
    "@type": "Person",
    "name": "Pedro Marco"
  },
  "dateCreated": obra.año ? String(obra.año) : undefined,
  "artMedium": tecnica || undefined,
  "image": ogImage,
  "description": obra.descripcion || undefined,
  "width": obra.dimensiones && obra.dimensiones !== 'No definido' ? obra.dimensiones : undefined,
  "url": `https://pedromarco.es/es/obra/${obra.id}`
};
---

<Base title={`${titulo} — Pedro Marco`} description={description} image={ogImage} jsonLd={jsonLd}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <a href="/es/" class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-900 mb-6 transition-colors">
      ← {t('artwork.back')}
    </a>

    <div class="bg-gray-100 rounded-xl overflow-hidden mb-4">
      <img
        id="main-img"
        src={`/obras/${obra.imagen}`}
        alt={obra.titulo}
        class="w-full h-auto object-contain cursor-zoom-in"
      />
    </div>

    {detailImages.length > 0 && (
      <div class="flex gap-2 mb-8 overflow-x-auto pb-2">
        <button class="detail-thumb active" data-src={`/obras/${obra.imagen}`}>
          <img src={`/obras/thumbs/${obra.imagen}`} alt={obra.titulo} />
        </button>
        {detailImages.map(img => (
          <button class="detail-thumb" data-src={`/obras/${img}`}>
            <img src={`/obras/thumbs/${img}`} alt={`${obra.titulo} — detalle`} loading="lazy" />
          </button>
        ))}
      </div>
    )}

    <!-- Details -->
    <div class="space-y-4">
      <h1 class="text-3xl font-bold">{obra.titulo}</h1>

      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 text-sm">
        <div>
          <span class="text-gray-400 block">{t('artwork.year')}</span>
          <span class="font-medium">{obra.año}</span>
        </div>
        <div>
          <span class="text-gray-400 block">{t('artwork.technique')}</span>
          <span class="font-medium">{obra.tecnica}</span>
        </div>
        <div>
          <span class="text-gray-400 block">{t('artwork.dimensions')}</span>
          <span class="font-medium">{obra.dimensiones}</span>
        </div>
        {obra.propietario && (
          <div>
            <span class="text-gray-400 block">Propietario</span>
            <span class="font-medium">{obra.propietario}</span>
          </div>
        )}
      </div>

      {obra.descripcion && obra.descripcion !== 'No definido' && (
        <p class="text-gray-600 leading-relaxed">{obra.descripcion}</p>
      )}

      {obra.en_venta && (
        <div class="pt-4">
          <span class="inline-flex items-center gap-1.5 text-sm font-medium text-green-700 bg-green-50 px-3 py-1.5 rounded-full">
            ● {t('artwork.for_sale')}
          </span>
        </div>
      )}
    </div>
  </div>

  <script is:inline>
    document.querySelectorAll('.detail-thumb').forEach(function(thumb) {
      thumb.addEventListener('click', function() {
        document.querySelectorAll('.detail-thumb').forEach(function(t) { t.classList.remove('active'); });
        thumb.classList.add('active');
        document.getElementById('main-img').src = thumb.getAttribute('data-src');
      });
    });
  </script>

  <style>
    .detail-thumb {
      width: 64px;
      height: 64px;
      min-width: 64px;
      border-radius: 8px;
      overflow: hidden;
      cursor: pointer;
      border: 2px solid #e5e7eb;
      transition: border-color 0.15s;
      padding: 0;
      background: none;
      flex-shrink: 0;
    }
    .detail-thumb:hover { border-color: #9ca3af; }
    .detail-thumb.active { border-color: #111; }
    .detail-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
  </style>
</Base>
