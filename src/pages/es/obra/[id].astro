---
import Base from '../../../layouts/Base.astro';
import { t } from '../../../i18n/utils';
import data from '../../../../obras.json';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  return data.obras.map(obra => ({ params: { id: obra.id } }));
}

const { id } = Astro.params;
const obra = data.obras.find(o => o.id === id);
if (!obra) return Astro.redirect('/es/obras');

// Find detail/variant images (_01, _02, etc.)
const obrasDir = path.resolve('public/obras');
const ext = path.extname(obra.imagen);
const base = path.basename(obra.imagen, ext);
const pattern = new RegExp(`^${base.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}_(\\d{2})${ext.replace('.', '\\.')}$`, 'i');
const detailImages = fs.readdirSync(obrasDir)
  .filter(f => pattern.test(f) && fs.statSync(path.join(obrasDir, f)).isFile())
  .sort();

const titulo = obra.titulo || '';
const tecnica = obra.tecnica || '';
const description = `${titulo}${tecnica ? ` — ${tecnica}` : ''}${obra.año ? ` (${obra.año})` : ''}. Obra de Pedro Marco, pintor de sueños de Villena.`;
const ogImage = `https://pedromarco.es/obras/${obra.imagen}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "VisualArtwork",
  "name": titulo,
  "artist": {
    "@type": "Person",
    "name": "Pedro Marco"
  },
  "dateCreated": obra.año ? String(obra.año) : undefined,
  "artMedium": tecnica || undefined,
  "image": ogImage,
  "description": obra.descripcion || undefined,
  "width": obra.dimensiones && obra.dimensiones !== 'No definido' ? obra.dimensiones : undefined,
  "url": `https://pedromarco.es/es/obra/${obra.id}`
};
---

<Base title={`${titulo} — Pedro Marco`} description={description} image={ogImage} jsonLd={jsonLd}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <a id="back-link" href="/es/obras" class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-900 mb-6 transition-colors">
      ← <span id="back-text">{t('artwork.back')}</span>
    </a>
    <script is:inline>
      (function() {
        var params = new URLSearchParams(window.location.search);
        if (params.get('from') === 'recorrido') {
          var link = document.getElementById('back-link');
          var text = document.getElementById('back-text');
          if (link) link.href = '/es/recorrido';
          if (text) text.textContent = 'Volver al recorrido';
        }
      })();
    </script>

    <div id="image-wrap" class="bg-gray-100 rounded-xl overflow-hidden mb-4 relative">
      <img
        id="main-img"
        src={`/obras/${obra.imagen}`}
        alt={obra.titulo}
        class="w-full h-auto object-contain"
        style="transform-origin: center center; transition: transform 0.2s ease;"
      />
      <!-- Zoom controls -->
      <div class="absolute bottom-3 right-3 flex items-center gap-2 px-3 py-1.5 bg-white/85 backdrop-blur-sm rounded-full shadow-sm text-xs">
        <span id="zoom-label" class="text-gray-500 min-w-[32px]">100%</span>
        <input type="range" id="zoom-slider" min="100" max="300" value="100" step="10" class="w-20 h-[3px] cursor-pointer accent-blue-500" />
      </div>
    </div>

    {detailImages.length > 0 && (
      <div class="flex gap-2 mb-8 overflow-x-auto pb-2">
        <button class="detail-thumb active" data-src={`/obras/${obra.imagen}`}>
          <img src={`/obras/thumbs/${obra.imagen}`} alt={obra.titulo} />
        </button>
        {detailImages.map(img => (
          <button class="detail-thumb" data-src={`/obras/${img}`}>
            <img src={`/obras/thumbs/${img}`} alt={`${obra.titulo} — detalle`} loading="lazy" />
          </button>
        ))}
      </div>
    )}

    <!-- Details -->
    <div class="space-y-4">
      <h1 class="text-3xl font-bold">{obra.titulo}</h1>

      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 text-sm">
        <div>
          <span class="text-gray-400 block">{t('artwork.year')}</span>
          <span class="font-medium">{obra.año}</span>
        </div>
        <div>
          <span class="text-gray-400 block">{t('artwork.technique')}</span>
          <span class="font-medium">{obra.tecnica}</span>
        </div>
        <div>
          <span class="text-gray-400 block">{t('artwork.dimensions')}</span>
          <span class="font-medium">{obra.dimensiones}</span>
        </div>
        {obra.propietario && (
          <div>
            <span class="text-gray-400 block">Propietario</span>
            <span class="font-medium">{obra.propietario}</span>
          </div>
        )}
      </div>

      {obra.descripcion && obra.descripcion !== 'No definido' && (
        <p class="text-gray-600 leading-relaxed">{obra.descripcion}</p>
      )}

      {obra.en_venta && (
        <div class="pt-4">
          <span class="inline-flex items-center gap-1.5 text-sm font-medium text-green-700 bg-green-50 px-3 py-1.5 rounded-full">
            ● {t('artwork.for_sale')}
          </span>
        </div>
      )}
    </div>
  </div>

  <script is:inline>
    (function() {
      var img = document.getElementById('main-img');
      var wrap = document.getElementById('image-wrap');
      var slider = document.getElementById('zoom-slider');
      var label = document.getElementById('zoom-label');
      var dragX = 0, dragY = 0, isDragging = false, startX = 0, startY = 0;

      function applyTransform() {
        var scale = slider.value / 100;
        img.style.transform = 'translate(' + dragX + 'px,' + dragY + 'px) scale(' + scale + ')';
      }

      function resetZoom() {
        dragX = 0; dragY = 0; isDragging = false;
        slider.value = 100;
        label.textContent = '100%';
        img.style.transform = '';
        img.style.cursor = '';
      }

      // Slider
      slider.addEventListener('input', function() {
        label.textContent = slider.value + '%';
        if (slider.value == 100) { dragX = 0; dragY = 0; }
        applyTransform();
        img.style.cursor = slider.value > 100 ? 'grab' : '';
      });

      // Mouse wheel zoom — only when already zoomed in
      wrap.addEventListener('wheel', function(e) {
        var cur = parseInt(slider.value);
        // If at 100% and scrolling down (zoom out), let page scroll normally
        if (cur <= 100 && e.deltaY > 0) return;
        // If at 100% and scrolling up, only zoom if Ctrl/Meta held
        if (cur <= 100 && e.deltaY < 0 && !e.ctrlKey && !e.metaKey) return;
        e.preventDefault();
        var val = cur + (e.deltaY < 0 ? 10 : -10);
        val = Math.max(100, Math.min(300, val));
        slider.value = val;
        label.textContent = val + '%';
        if (val == 100) { dragX = 0; dragY = 0; }
        applyTransform();
        img.style.cursor = val > 100 ? 'grab' : '';
      }, { passive: false });

      // Mouse drag
      img.addEventListener('mousedown', function(e) {
        if (slider.value <= 100) return;
        isDragging = true;
        startX = e.clientX - dragX;
        startY = e.clientY - dragY;
        img.style.cursor = 'grabbing';
        img.style.transition = 'none';
        e.preventDefault();
      });
      document.addEventListener('mousemove', function(e) {
        if (!isDragging) return;
        dragX = e.clientX - startX;
        dragY = e.clientY - startY;
        applyTransform();
      });
      document.addEventListener('mouseup', function() {
        if (!isDragging) return;
        isDragging = false;
        img.style.cursor = 'grab';
        img.style.transition = '';
      });

      // Touch: pinch-to-zoom + drag
      var pinchStartDist = 0, pinchStartScale = 1, isPinching = false;
      function touchDist(t1, t2) {
        var dx = t1.clientX - t2.clientX, dy = t1.clientY - t2.clientY;
        return Math.sqrt(dx * dx + dy * dy);
      }
      img.addEventListener('touchstart', function(e) {
        if (e.touches.length === 2) {
          isPinching = true; isDragging = false;
          pinchStartDist = touchDist(e.touches[0], e.touches[1]);
          pinchStartScale = parseInt(slider.value) / 100;
          img.style.transition = 'none';
          e.preventDefault();
        } else if (e.touches.length === 1 && parseInt(slider.value) > 100) {
          isDragging = true;
          startX = e.touches[0].clientX - dragX;
          startY = e.touches[0].clientY - dragY;
          img.style.transition = 'none';
        }
      }, { passive: false });
      document.addEventListener('touchmove', function(e) {
        if (isPinching && e.touches.length === 2) {
          var dist = touchDist(e.touches[0], e.touches[1]);
          var s = Math.max(1, Math.min(3, pinchStartScale * (dist / pinchStartDist)));
          var val = Math.round(s * 100);
          slider.value = val; label.textContent = val + '%';
          if (val <= 100) { dragX = 0; dragY = 0; }
          applyTransform();
          e.preventDefault();
        } else if (isDragging && e.touches.length === 1) {
          dragX = e.touches[0].clientX - startX;
          dragY = e.touches[0].clientY - startY;
          applyTransform();
        }
      }, { passive: false });
      document.addEventListener('touchend', function(e) {
        if (isPinching) {
          isPinching = false; img.style.transition = '';
          if (parseInt(slider.value) <= 100) resetZoom();
        }
        if (isDragging && e.touches.length === 0) {
          isDragging = false; img.style.transition = '';
        }
      });

      // Double-click to toggle zoom
      img.addEventListener('dblclick', function() {
        if (slider.value > 100) { resetZoom(); }
        else { slider.value = 200; label.textContent = '200%'; applyTransform(); img.style.cursor = 'grab'; }
      });

      // Detail thumbs
      document.querySelectorAll('.detail-thumb').forEach(function(thumb) {
        thumb.addEventListener('click', function() {
          document.querySelectorAll('.detail-thumb').forEach(function(t) { t.classList.remove('active'); });
          thumb.classList.add('active');
          img.src = thumb.getAttribute('data-src');
          resetZoom();
        });
      });
    })();
  </script>

  <style>
    .detail-thumb {
      width: 64px;
      height: 64px;
      min-width: 64px;
      border-radius: 8px;
      overflow: hidden;
      cursor: pointer;
      border: 2px solid #e5e7eb;
      transition: border-color 0.15s;
      padding: 0;
      background: none;
      flex-shrink: 0;
    }
    .detail-thumb:hover { border-color: #9ca3af; }
    .detail-thumb.active { border-color: #111; }
    .detail-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
  </style>
</Base>
