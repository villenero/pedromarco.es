---
import Base from '../../layouts/Base.astro';
import { t } from '../../i18n/utils';
const lang = 'en';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Pedro Marco",
  "birthDate": "1949",
  "deathDate": "2022",
  "birthPlace": { "@type": "Place", "name": "Villena, Alicante, Spain" },
  "nationality": "Spanish",
  "jobTitle": "Painter",
  "description": "Pedro Marco (Villena, Alicante, 1949-2022) devoted himself entirely to the visual arts from 1972. Self-taught, he specialised in printmaking after a scholarship in Hamburg (Germany) in 1982.",
  "knowsAbout": ["Painting", "Printmaking", "Surrealism", "Visual arts"],
  "sameAs": "https://pedromarco.es"
};
---

<Base
  title="Pedro Marco — Artist biography"
  description="Biography of Pedro Marco (Villena, 1949-2022), self-taught painter specialising in surrealism and printmaking."
  lang={lang}
  jsonLd={jsonLd}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="text-3xl font-bold mb-8">{t(lang, 'about.title')}</h1>
    <div class="prose prose-gray max-w-none text-gray-600 leading-relaxed space-y-4">
      <p>
        Pedro Marco (Villena, Alicante, 1949 – 2022) devoted himself entirely to the visual arts from 1972 onwards. He described himself as self-taught, yet his talent for drawing stood out from a very early age. That skill led him to train at private academies, where he became an exceptional draughtsman. In 1982 he was awarded a scholarship to study art in Hamburg (Germany), where he specialised in printmaking.
      </p>
      <p>
        His relentless curiosity and thirst for knowledge drove him to discover new cultures and travel through countries such as Venezuela, Belgium, France, Germany, Italy, the United Kingdom, Jordan, Syria, Algeria and the United States — places from which he drew ample material to fuel his compositions.
      </p>
      <p>
        He held his first solo exhibition at just seventeen years of age in his hometown, and from that moment on a wealth of solo and group exhibitions followed, both nationally and internationally. Villena, Caracas, Madrid, San Sebastián, Murcia, Alicante, Paris, Barcelona, Florence and London are among the cities where audiences have admired his work, always imbued with an aura of surrealism and fantasy. His pieces have been acquired by public and private institutions, and have been selected and awarded prizes in numerous painting competitions.
      </p>
    </div>
  </div>
</Base>
