---
import '../styles/global.css';
import obrasData from '../../obras.json';

interface Props {
  title: string;
  description?: string;
  image?: string;
  jsonLd?: Record<string, any>;
  bodyClass?: string;
}

const siteUrl = 'https://pedromarco.es';
const totalObras = obrasData.obras.length;
const buildDate = new Date().toLocaleDateString('es-ES', { year: 'numeric', month: 'long' });

const { title, description = 'Pedro Marco Hernández — Pintor', image, jsonLd, bodyClass = '' } = Astro.props;

const currentPath = Astro.url.pathname;
const canonicalUrl = `${siteUrl}${currentPath}`;
const ogImage = image ?? `${siteUrl}/favicon-512.png`;

const isLanding = currentPath === '/es/' || currentPath === '/es';
const bodyClasses = ['site-body', 'grain', bodyClass].filter(Boolean).join(' ');
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <link rel="canonical" href={canonicalUrl} />

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_ES" />
  <meta property="og:site_name" content="Pedro Marco" />

  <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  {jsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )}

  <title>{title}</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=IBM+Plex+Sans:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />
</head>
<body class={bodyClasses}>

  <!-- NAV -->
  <nav class="site" id="site-nav">
    <div class="nav-inner">
      <a href="/es/" class="brand" aria-label="Pedro Marco — inicio">
        <img src="/logo.png" alt="Pedro Marco — firma" />
      </a>
      <div class="nav-links">
        <a href="/es/obras">Obra</a>
        <a href="/es/sobre">Biografía</a>
        <a href="/es/recorrido">Recorrido</a>
        <a href="/es/contacto" class="nav-cta">Colaborar</a>
      </div>
      <button class="nav-burger" id="nav-burger" aria-label="Menú" aria-expanded="false">
        <svg id="burger-open" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
        <svg id="burger-close" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="display:none"><path stroke-linecap="round" d="M6 6l12 12M6 18L18 6"/></svg>
      </button>
    </div>
    <div class="mobile-menu" id="mobile-menu">
      <div class="mm-inner">
        <a href="/es/obras">Obra</a>
        <a href="/es/sobre">Biografía</a>
        <a href="/es/recorrido">Recorrido</a>
        <a href="/es/contacto" class="nav-cta">Colaborar</a>
      </div>
    </div>
  </nav>

  <script is:inline>
    (function() {
      var nav = document.getElementById('site-nav');
      var burger = document.getElementById('nav-burger');
      var menu = document.getElementById('mobile-menu');
      var iconOpen = document.getElementById('burger-open');
      var iconClose = document.getElementById('burger-close');

      if (burger && menu) {
        burger.addEventListener('click', function() {
          var open = menu.classList.toggle('open');
          burger.setAttribute('aria-expanded', open ? 'true' : 'false');
          if (iconOpen) iconOpen.style.display = open ? 'none' : '';
          if (iconClose) iconClose.style.display = open ? '' : 'none';
        });
      }

      if (nav) {
        window.addEventListener('scroll', function() {
          nav.classList.toggle('scrolled', window.scrollY > 8);
        }, { passive: true });
      }
    })();
  </script>

  {!isLanding && (
    <>
      <!-- Welcome modal (first visit only, not on landing) -->
      <div id="welcome-modal" class="fixed inset-0 z-[200] flex items-center justify-center p-4" style="display:none">
        <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" id="welcome-backdrop"></div>
        <div class="relative bg-white rounded-2xl shadow-2xl max-w-lg w-full overflow-hidden animate-modal-in">
          <button id="welcome-x" class="absolute top-3 right-3 z-10 w-8 h-8 flex items-center justify-center rounded-full text-gray-400 hover:text-gray-600 hover:bg-gray-100 transition-colors" aria-label="Cerrar">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" d="M6 6l12 12M6 18L18 6"/></svg>
          </button>
          <div class="bg-gradient-to-br from-amber-50 to-orange-50 px-6 sm:px-8 pt-6 sm:pt-8 pb-4 sm:pb-6 text-center">
            <img src="/favicon.png" alt="" class="w-12 sm:w-16 h-12 sm:h-16 mx-auto mb-3 sm:mb-4 opacity-70" />
            <h2 class="text-xl sm:text-2xl font-bold text-gray-900 mb-1">Ayúdanos a preservar su legado</h2>
            <p class="text-amber-800/70 text-sm">Pedro Marco · Villena, 1949–2022</p>
          </div>
          <div class="px-6 sm:px-8 py-4 sm:py-6 text-gray-600 text-sm sm:text-[15px] leading-relaxed space-y-3 sm:space-y-4">
            <p>
              A lo largo de más de 56 años de trayectoria, Pedro Marco creó un cuerpo de obra extenso hoy disperso en colecciones privadas, instituciones y hogares.
            </p>
            <p>
              <strong class="text-gray-800">¿Tienes una obra suya?</strong> Un cuadro, grabado o dibujo… Nos encantaría saber de él.
            </p>
            <div class="flex items-start gap-3 bg-amber-50/60 rounded-xl p-3 sm:p-4 text-sm">
              <span class="text-lg sm:text-xl mt-0.5">📷</span>
              <span>Basta con una foto desde el móvil y cualquier dato que conozcas.</span>
            </div>
          </div>
          <div class="px-6 sm:px-8 pb-6 sm:pb-8 flex flex-col sm:flex-row gap-3">
            <a
              id="welcome-collaborate"
              href="/es/contacto"
              class="flex-1 inline-flex items-center justify-center gap-2 bg-amber-800 text-white px-5 py-3 rounded-xl font-medium hover:bg-amber-900 transition-colors text-sm"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
              </svg>
              Quiero colaborar
            </a>
            <button
              id="welcome-close"
              class="flex-1 px-5 py-3 rounded-xl font-medium text-gray-500 hover:text-gray-700 hover:bg-gray-100 transition-colors text-sm"
            >
              Ahora no, gracias
            </button>
          </div>
        </div>
      </div>

      <style is:global>
        @keyframes modal-in {
          from { opacity: 0; transform: translateY(20px) scale(0.97); }
          to { opacity: 1; transform: translateY(0) scale(1); }
        }
        .animate-modal-in {
          animation: modal-in 0.35s ease-out;
        }
      </style>

      {!currentPath.includes('/contacto') && (
        <button
          id="snail-fab"
          aria-label="Colaborar con el catálogo"
          class="fixed bottom-6 right-6 z-[150] w-12 h-12 rounded-full backdrop-blur-sm shadow-lg flex items-center justify-center hover:shadow-xl hover:scale-110 transition-all duration-300 cursor-pointer group"
          style="background: color-mix(in srgb, var(--paper) 85%, transparent); border: 1px solid var(--line);"
        >
          <img src="/favicon.png" alt="" class="w-7 h-7 opacity-50 group-hover:opacity-80 transition-opacity" />
        </button>
      )}

      <script is:inline>
        (function() {
          var modal = document.getElementById('welcome-modal');
          var fab = document.getElementById('snail-fab');
          if (!modal) return;

          function openModal() { modal.style.display = 'flex'; }
          function dismiss() {
            localStorage.setItem('pm_welcome_seen', '1');
            modal.style.display = 'none';
          }

          if (!localStorage.getItem('pm_welcome_seen')) {
            setTimeout(openModal, 1500);
          }

          if (fab) fab.addEventListener('click', openModal);

          var closeBtn = document.getElementById('welcome-close');
          var xBtn = document.getElementById('welcome-x');
          var bdBtn = document.getElementById('welcome-backdrop');
          var collab = document.getElementById('welcome-collaborate');
          if (closeBtn) closeBtn.addEventListener('click', dismiss);
          if (xBtn) xBtn.addEventListener('click', dismiss);
          if (bdBtn) bdBtn.addEventListener('click', dismiss);
          if (collab) collab.addEventListener('click', function() {
            localStorage.setItem('pm_welcome_seen', '1');
          });
          document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' && modal.style.display === 'flex') dismiss();
          });
        })();
      </script>
    </>
  )}

  <!-- Content -->
  <main>
    <slot />
  </main>

  <!-- FOOTER -->
  <footer class="site" id="contacto">
    <div class="footer-inner">
      <div class="footer-top">
        <h3 class="footer-big">
          Un archivo <em>vivo,</em><br/>
          hecho entre <em>todos.</em>
        </h3>
        <div class="footer-col">
          <h5>Navegación</h5>
          <ul>
            <li><a href="/es/obras">Obra</a></li>
            <li><a href="/es/sobre">Biografía</a></li>
            <li><a href="/es/recorrido">Recorrido</a></li>
            <li><a href="/es/propietarios">Propietarios</a></li>
            <li><a href="/es/historias">Historias</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h5>Familia Pedro Marco</h5>
          <ul>
            <li><a href="mailto:pedromarco@pedromarco.es">pedromarco@pedromarco.es</a></li>
            <li>Villena · Alicante, España</li>
            <li style="margin-top:16px;"><a href="/es/contacto">Formulario de contacto →</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© {new Date().getFullYear()} Familia Pedro Marco — Todos los derechos reservados</span>
        <span>{totalObras} obras catalogadas · actualizado {buildDate}</span>
      </div>
    </div>
  </footer>
</body>
</html>
