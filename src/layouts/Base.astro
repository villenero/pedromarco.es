---
import '../styles/global.css';
import { t } from '../i18n/utils';
import obrasData from '../../obras.json';

interface Props {
  title: string;
  description?: string;
  image?: string;
  jsonLd?: Record<string, any>;
}

const siteUrl = 'https://pedromarco.es';
const totalObras = obrasData.obras.length;
const buildDate = new Date().toLocaleDateString('es-ES', { year: 'numeric', month: 'long' });

const { title, description = 'Pedro Marco Hernández — Pintor', image, jsonLd } = Astro.props;

const currentPath = Astro.url.pathname;
const canonicalUrl = `${siteUrl}${currentPath}`;
const ogImage = image ?? `${siteUrl}/favicon-512.png`;
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <!-- SEO -->
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_ES" />
  <meta property="og:site_name" content="Pedro Marco" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  {jsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )}

  <title>{title}</title>
</head>
<body class="min-h-screen bg-white text-gray-900 flex flex-col">
  <!-- Navigation -->
  <nav class="sticky top-0 z-50 bg-white/80 backdrop-blur-md">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <!-- Logo -->
        <a href="/es/" class="hover:opacity-70 transition-opacity">
          <img src="/logo.png" alt="Pedro Marco" class="h-8" />
        </a>

        <!-- Nav links (desktop) -->
        <div class="hidden sm:flex items-center gap-6 text-sm">
          <a href="/es/" class="hover:opacity-70 transition-opacity">
            {t('nav.home')}
          </a>
          <a href="/es/sobre" class="hover:opacity-70 transition-opacity">
            {t('nav.about')}
          </a>
        </div>

        <!-- Hamburger (mobile) -->
        <button id="menu-toggle" class="sm:hidden p-2 -mr-2" aria-label="Menu">
          <svg id="icon-open" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg id="icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" d="M6 6l12 12M6 18L18 6"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="sm:hidden hidden border-t border-gray-100 bg-white/95 backdrop-blur-md">
      <div class="flex flex-col px-4 py-3 gap-3 text-sm">
        <a href="/es/" class="py-1 hover:opacity-70 transition-opacity">
          {t('nav.home')}
        </a>
        <a href="/es/sobre" class="py-1 hover:opacity-70 transition-opacity">
          {t('nav.about')}
        </a>
      </div>
    </div>
  </nav>

  <script is:inline>
    document.getElementById('menu-toggle').addEventListener('click', () => {
      const menu = document.getElementById('mobile-menu');
      const open = document.getElementById('icon-open');
      const close = document.getElementById('icon-close');
      menu.classList.toggle('hidden');
      open.classList.toggle('hidden');
      close.classList.toggle('hidden');
    });
  </script>

  <!-- Welcome modal (first visit only) -->
  <div id="welcome-modal" class="fixed inset-0 z-[200] flex items-center justify-center p-4" style="display:none">
    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" id="welcome-backdrop"></div>
    <div class="relative bg-white rounded-2xl shadow-2xl max-w-lg w-full overflow-hidden animate-modal-in">
      <!-- Header con fondo cálido -->
      <div class="bg-gradient-to-br from-amber-50 to-orange-50 px-8 pt-8 pb-6 text-center">
        <img src="/favicon.png" alt="" class="w-16 h-16 mx-auto mb-4 opacity-70" />
        <h2 class="text-2xl font-bold text-gray-900 mb-1">Ayúdanos a preservar su legado</h2>
        <p class="text-amber-800/70 text-sm">Pedro Marco · Villena, 1949–2022</p>
      </div>
      <!-- Body -->
      <div class="px-8 py-6 text-gray-600 text-[15px] leading-relaxed space-y-4">
        <p>
          A lo largo de más de 56 años de trayectoria, Pedro Marco creó un cuerpo de obra extenso que hoy se encuentra disperso en colecciones privadas, instituciones y hogares.
        </p>
        <p>
          <strong class="text-gray-800">¿Tienes una obra suya?</strong> Un cuadro, un grabado, un dibujo… Nos encantaría saber de él. Cada pieza recuperada es un paso más para completar el catálogo del artista.
        </p>
        <div class="flex items-start gap-3 bg-amber-50/60 rounded-xl p-4 text-sm">
          <span class="text-xl mt-0.5">📷</span>
          <span>Basta con una foto desde el móvil y cualquier dato que conozcas: título, año, cómo llegó a tus manos…</span>
        </div>
      </div>
      <!-- Actions -->
      <div class="px-8 pb-8 flex flex-col sm:flex-row gap-3">
        <a
          id="welcome-collaborate"
          href="/es/contacto"
          class="flex-1 inline-flex items-center justify-center gap-2 bg-amber-800 text-white px-5 py-3 rounded-xl font-medium hover:bg-amber-900 transition-colors text-sm"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
          </svg>
          Quiero colaborar
        </a>
        <button
          id="welcome-close"
          class="flex-1 px-5 py-3 rounded-xl font-medium text-gray-500 hover:text-gray-700 hover:bg-gray-100 transition-colors text-sm"
        >
          Ahora no, gracias
        </button>
      </div>
    </div>
  </div>

  <style>
    @keyframes modal-in {
      from { opacity: 0; transform: translateY(20px) scale(0.97); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }
    .animate-modal-in {
      animation: modal-in 0.35s ease-out;
    }
  </style>

  <!-- Floating snail button -->
  <button
    id="snail-fab"
    aria-label="Colaborar con el catálogo"
    class="fixed bottom-6 right-6 z-[150] w-12 h-12 rounded-full bg-white/80 backdrop-blur-sm shadow-lg border border-gray-200/60 flex items-center justify-center hover:bg-amber-50 hover:shadow-xl hover:scale-110 transition-all duration-300 cursor-pointer group"
  >
    <img src="/favicon.png" alt="" class="w-7 h-7 opacity-50 group-hover:opacity-80 transition-opacity" />
  </button>

  <script is:inline>
    (function() {
      var modal = document.getElementById('welcome-modal');
      var fab = document.getElementById('snail-fab');

      function openModal() {
        modal.style.display = 'flex';
      }
      function dismiss() {
        localStorage.setItem('pm_welcome_seen', '1');
        modal.style.display = 'none';
      }

      // First visit: auto-show after delay
      if (!localStorage.getItem('pm_welcome_seen')) {
        setTimeout(openModal, 1500);
      }

      // Floating button always opens modal
      fab.addEventListener('click', openModal);

      // Close handlers
      document.getElementById('welcome-close').addEventListener('click', dismiss);
      document.getElementById('welcome-backdrop').addEventListener('click', dismiss);
      document.getElementById('welcome-collaborate').addEventListener('click', function() {
        localStorage.setItem('pm_welcome_seen', '1');
      });
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && modal.style.display === 'flex') dismiss();
      });
    })();
  </script>

  <!-- Content -->
  <main class="flex-1">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="border-t border-gray-100 py-8 text-center text-sm text-gray-400">
    <div class="mb-2 flex items-center justify-center gap-4">
      <a href="/es/" class="hover:text-gray-600 transition-colors">
        {t('nav.home')}
      </a>
      <a href="/es/sobre" class="hover:text-gray-600 transition-colors">
        {t('nav.about')}
      </a>
      <a href="/es/contacto" class="hover:text-gray-600 transition-colors">
        {t('nav.contact')}
      </a>
    </div>
    <img src="/favicon.png" alt="" class="h-6 mx-auto mb-2 opacity-40" />
    <p>&copy; {new Date().getFullYear()} Familia Pedro Marco. {t('footer.rights')}.</p>
    <p class="mt-2 text-xs text-gray-300">{totalObras} obras catalogadas · Actualizado {buildDate}</p>
  </footer>
</body>
</html>
