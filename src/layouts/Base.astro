---
import '../styles/global.css';
import { t, getLangFromUrl, getLocalizedPath, type Lang } from '../i18n/utils';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
}

const { title, description = 'Pedro Marco Hernández — Pintor', lang: propLang } = Astro.props;
const lang = propLang ?? getLangFromUrl(Astro.url);
const otherLang = lang === 'es' ? 'en' : 'es';

// Build the equivalent path in the other language
const currentPath = Astro.url.pathname;
const pathWithoutLang = currentPath.replace(/^\/(es|en)/, '').replace(/\/$/, '') || '/';

// Map translated route segments between languages
const routeMap: Record<string, string> = {
  '/sobre': '/about',
  '/about': '/sobre',
  '/contacto': '/contact',
  '/contact': '/contacto',
  '/obra': '/work',
  '/work': '/obra',
};

let translatedPath = pathWithoutLang;
for (const [from, to] of Object.entries(routeMap)) {
  if (translatedPath === from || translatedPath.startsWith(from + '/')) {
    translatedPath = translatedPath.replace(from, to);
    break;
  }
}

const otherLangPath = `/${otherLang}${translatedPath}`;
---

<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <title>{title}</title>
</head>
<body class="min-h-screen bg-white text-gray-900 flex flex-col">
  <!-- Navigation -->
  <nav class="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <!-- Logo -->
        <a href={getLocalizedPath(lang, '/')} class="hover:opacity-70 transition-opacity">
          <img src="/logo.png" alt="Pedro Marco" class="h-8" />
        </a>

        <!-- Nav links -->
        <div class="flex items-center gap-6 text-sm">
          <a href={getLocalizedPath(lang, '/')} class="hover:opacity-70 transition-opacity">
            {t(lang, 'nav.home')}
          </a>
          <a href={getLocalizedPath(lang, lang === 'es' ? '/sobre' : '/about')} class="hover:opacity-70 transition-opacity">
            {t(lang, 'nav.about')}
          </a>
          <!-- Language switcher -->
          <a href={otherLangPath} class="uppercase text-xs font-medium px-2 py-1 border border-gray-300 rounded hover:bg-gray-100 transition-colors">
            {otherLang}
          </a>
        </div>
      </div>
    </div>
  </nav>

  <!-- Content -->
  <main class="flex-1">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="border-t border-gray-100 py-8 text-center text-sm text-gray-400">
    <div class="mb-2">
      <a href={getLocalizedPath(lang, lang === 'es' ? '/contacto' : '/contact')} class="hover:text-gray-600 transition-colors">
        {t(lang, 'nav.contact')}
      </a>
    </div>
    <p>&copy; {new Date().getFullYear()} Pedro Marco Hernández. {t(lang, 'footer.rights')}.</p>
  </footer>
</body>
</html>
